<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SecureChat.App.Views"
             x:Class="SecureChat.App.Pages.SpaceMediaPage"
             Title="{DynamicResource s_ui_062}">
    <Grid RowDefinitions="Auto,Auto,*"
          BackgroundColor="{DynamicResource PageBackground}">

        <Label Grid.Row="0"
               x:Name="TitleLabel"
               Text="{DynamicResource s_ui_062}"
               Style="{DynamicResource H2}"
               Margin="16,12,16,4" />

        <Label Grid.Row="1"
               x:Name="StatusLabel"
               Style="{DynamicResource Caption}"
               Margin="16,0,16,8" />

        <CollectionView Grid.Row="2"
                        x:Name="ItemsView"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="{DynamicResource s_ui_005}"
                       Style="{DynamicResource Caption}"
                       Margin="24"
                       HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:SpaceMediaItemVm">
                    <VerticalStackLayout Spacing="0">

                        <!-- Заголовок группы по дате -->
                        <Border IsVisible="{Binding IsHeader}"
                                BackgroundColor="Transparent"
                                Padding="12,12,12,4">
                            <Label Text="{Binding Title}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMuted}" />
                        </Border>

                        <!-- Само вложение -->
                        <Grid IsVisible="{Binding IsItem}"
                              Padding="12,4"
                              ColumnDefinitions="44,*"
                              ColumnSpacing="10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="📎"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextPrimary}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Author}"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
