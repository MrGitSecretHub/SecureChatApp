<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SecureChat.App.Views"
             x:Class="SecureChat.App.Pages.SpacesPage"
             Title="{DynamicResource s_ui_024}">
    <ContentPage.Resources>
        <!-- Компактные «пилюли» фильтров -->
        <Style x:Key="FilterPill" TargetType="Button">
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
        <Style x:Key="FilterPillActive" TargetType="Button" BasedOn="{StaticResource FilterPill}">
            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
            <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!-- Шапка -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="16,12,16,2"
                             Spacing="2">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{DynamicResource s_spaces_title}" Style="{DynamicResource H1}" />
                    <Label Text="{DynamicResource s_spaces_subtitle}"
                           Style="{DynamicResource Caption}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        x:Name="JoinRequestsButton"
                        Text="📥"
                        Style="{DynamicResource IconButton}"
                        VerticalOptions="Center"
                        IsVisible="False"
                        Clicked="OnJoinRequestsClicked"
                        ToolTipProperties.Text="{DynamicResource s_spaces_join_requests}" />
            </Grid>
        </VerticalStackLayout>

        <SearchBar Grid.Row="1"
                   x:Name="SearchEntry"
                   Placeholder="{DynamicResource s_spaces_search}"
                   Margin="16,0,16,0"
                   TextChanged="OnSearchTextChanged" />

        <!-- Фильтр по типу: пилюли -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HeightRequest="44"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="16,6" Spacing="6">
                <Button x:Name="AllFilterButton"
                        Text="{DynamicResource s_spaces_all}"
                        ClassId="all"
                        Style="{StaticResource FilterPillActive}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="GroupsFilterButton"
                        Text="{DynamicResource s_spaces_groups}"
                        ClassId="group"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="ChannelsFilterButton"
                        Text="{DynamicResource s_spaces_channels}"
                        ClassId="channel"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="ForumsFilterButton"
                        Text="{DynamicResource s_spaces_forums}"
                        ClassId="forum"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="CommunitiesFilterButton"
                        Text="{DynamicResource s_spaces_communities}"
                        ClassId="community"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Истории пространств: лента над списком -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8"
              Padding="16,0,16,4">
            <Button x:Name="SpaceStoriesAddButton"
                    Text="＋"
                    WidthRequest="38" HeightRequest="38"
                    CornerRadius="19" FontSize="16" Padding="0"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    TextColor="{DynamicResource Accent}"
                    VerticalOptions="Center"
                    Clicked="OnSpaceStoriesAddClicked" />
            <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="SpaceStoriesStrip" Spacing="6" VerticalOptions="Center" />
            </ScrollView>
        </Grid>

        <Label x:Name="OfflineLabel"
               Grid.Row="4"
               Margin="16,0,16,6"
               FontSize="12"
               TextColor="{DynamicResource Warning}"
               LineBreakMode="WordWrap"
               IsVisible="False"
               Text="{DynamicResource s_ui_189}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRetryTapped" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Компактный список (строки строятся в коде) -->
        <ScrollView Grid.Row="5"
                    x:Name="SpacesScroll"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="SpacesList"
                                 Spacing="0"
                                 Padding="0,0,0,80" />
        </ScrollView>

        <!-- Плавающая кнопка создания -->
        <Button Grid.Row="5"
                x:Name="CreateFab"
                Text="＋"
                FontSize="26"
                WidthRequest="54"
                HeightRequest="54"
                CornerRadius="27"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                Style="{DynamicResource PrimaryButton}"
                Clicked="OnCreateClicked"
                ToolTipProperties.Text="{DynamicResource s_ui_152}" />
    </Grid>
</ContentPage>
