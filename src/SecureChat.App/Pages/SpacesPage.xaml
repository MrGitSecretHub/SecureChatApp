<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SecureChat.App.Views"
             x:Class="SecureChat.App.Pages.SpacesPage"
             Title="{DynamicResource s_ui_024}">
    <ContentPage.Resources>
        <!-- Компактные «пилюли» фильтров -->
        <Style x:Key="FilterPill" TargetType="Button">
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
        <Style x:Key="FilterPillActive" TargetType="Button" BasedOn="{StaticResource FilterPill}">
            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
            <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Шапка -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="16,12,16,2"
                             Spacing="2">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{DynamicResource s_spaces_title}" Style="{DynamicResource H1}" />
                    <Label Text="{DynamicResource s_spaces_subtitle}"
                           Style="{DynamicResource Caption}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        x:Name="JoinRequestsButton"
                        Text="📥"
                        Style="{DynamicResource IconButton}"
                        VerticalOptions="Center"
                        IsVisible="False"
                        Clicked="OnJoinRequestsClicked"
                        ToolTipProperties.Text="{DynamicResource s_spaces_join_requests}" />
            </Grid>
        </VerticalStackLayout>

        <SearchBar Grid.Row="1"
                   x:Name="SearchEntry"
                   Placeholder="{DynamicResource s_spaces_search}"
                   Margin="16,0,16,0"
                   TextChanged="OnSearchTextChanged" />

        <!-- Фильтр по типу: пилюли -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HeightRequest="44"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="16,6" Spacing="6">
                <Button x:Name="AllFilterButton"
                        Text="{DynamicResource s_spaces_all}"
                        ClassId="all"
                        Style="{StaticResource FilterPillActive}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="GroupsFilterButton"
                        Text="{DynamicResource s_spaces_groups}"
                        ClassId="group"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="ChannelsFilterButton"
                        Text="{DynamicResource s_spaces_channels}"
                        ClassId="channel"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="ForumsFilterButton"
                        Text="{DynamicResource s_spaces_forums}"
                        ClassId="forum"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
                <Button x:Name="CommunitiesFilterButton"
                        Text="{DynamicResource s_spaces_communities}"
                        ClassId="community"
                        Style="{StaticResource FilterPill}"
                        Clicked="OnFilterClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <Label x:Name="OfflineLabel"
               Grid.Row="3"
               Margin="16,0,16,6"
               FontSize="12"
               TextColor="{DynamicResource Warning}"
               LineBreakMode="WordWrap"
               IsVisible="False"
               Text="{DynamicResource s_ui_189}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRetryTapped" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Компактный список с группировкой -->
        <CollectionView Grid.Row="4"
                        x:Name="SpacesView"
                        SelectionMode="Single"
                        SelectionChanged="OnSpaceSelected"
                        BackgroundColor="Transparent">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,32" Spacing="10" VerticalOptions="Center">
                    <Label Text="📢"
                           Style="{DynamicResource EmptyStateIcon}" />
                    <Label Text="{DynamicResource s_ui_135}"
                           Style="{DynamicResource EmptyStateTitle}" />
                    <Label Text="{DynamicResource s_ui_151}"
                           Style="{DynamicResource EmptyStateCaption}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Title}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}"
                           Padding="16,10,16,4"
                           BackgroundColor="Transparent" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:SpaceVm">
                    <Grid ColumnDefinitions="46,*,Auto"
                          ColumnSpacing="10"
                          Padding="12,6"
                          HeightRequest="64">
                        <Border WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AccentSoft}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Label Text="{Binding Icon}"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PreviewLine}"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextMuted}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding MembersText}"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDisabled}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2"
                                             Spacing="3"
                                             VerticalOptions="Center"
                                             HorizontalOptions="End">
                            <Label Text="{Binding TimeText}"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextDisabled}"
                                   HorizontalOptions="End" />
                            <Label Text="{Binding TypeBadge}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}"
                                   HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Плавающая кнопка создания -->
        <Button Grid.Row="4"
                x:Name="CreateFab"
                Text="＋"
                FontSize="26"
                WidthRequest="54"
                HeightRequest="54"
                CornerRadius="27"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                Style="{DynamicResource PrimaryButton}"
                Clicked="OnCreateClicked"
                ToolTipProperties.Text="{DynamicResource s_ui_152}" />
    </Grid>
</ContentPage>
