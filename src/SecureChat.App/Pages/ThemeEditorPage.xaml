<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Pages.ThemeEditorPage"
             Title="{DynamicResource s_ui_058}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Шапка: имя редактируемой темы и выход -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="EditorTitleLabel"
                           Text="{DynamicResource s_ui_088}"
                           Style="{DynamicResource H2}" />
                    <Label x:Name="EditorBaseLabel"
                           Style="{DynamicResource Caption}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        x:Name="CloseButton"
                        Text="✕"
                        Style="{DynamicResource IconButton}"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked"
                        ToolTipProperties.Text="Закрыть" />
            </Grid>

            <!-- Превью -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="{DynamicResource s_ui_131}"
                               Style="{DynamicResource H2}" />
                        <Label Grid.Column="1"
                               x:Name="PreviewBaseLabel"
                               Style="{DynamicResource Caption}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Имитация экрана переписки: шапка, панель, пузыри, поле ввода -->
                    <Border BackgroundColor="{DynamicResource PageBackground}"
                            Padding="10"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">

                            <!-- Шапка: акцентная кнопка, текст, подпись -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource Accent}"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Label Text="{DynamicResource s_ui_150}"
                                           TextColor="{DynamicResource TextPrimary}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                    <Label Text="{DynamicResource s_ui_177}"
                                           TextColor="{DynamicResource TextMuted}"
                                           FontSize="10" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="12:34"
                                       TextColor="{DynamicResource TextMuted}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Панель: подложка и граница -->
                            <Border BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{DynamicResource s_ui_160}"
                                           TextColor="{DynamicResource TextPrimary}"
                                           FontSize="12" />
                                    <Label Text="{DynamicResource s_ui_179}"
                                           TextColor="{DynamicResource TextSecondary}"
                                           FontSize="11" />
                                    <Label Text="{DynamicResource s_ui_181}"
                                           TextColor="{DynamicResource TextMuted}"
                                           FontSize="10" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Чужой пузырь -->
                            <Border BackgroundColor="{DynamicResource MessageThem}"
                                    Padding="10,6"
                                    HorizontalOptions="Start"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{DynamicResource s_ui_154}"
                                       TextColor="{DynamicResource MessageThemText}"
                                       FontSize="13" />
                            </Border>

                            <!-- Свой пузырь -->
                            <Border BackgroundColor="{DynamicResource MessageMe}"
                                    Padding="10,6"
                                    HorizontalOptions="End"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{DynamicResource s_ui_006}"
                                       TextColor="{DynamicResource AccentText}"
                                       FontSize="13" />
                            </Border>

                            <!-- Статусы -->
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{DynamicResource s_ui_182}"
                                       TextColor="{DynamicResource Success}"
                                       FontSize="11" />
                                <Label Text="{DynamicResource s_ui_180}"
                                       TextColor="{DynamicResource Danger}"
                                       FontSize="11" />
                                <Label Text="{DynamicResource s_ui_178}"
                                       TextColor="{DynamicResource Warning}"
                                       FontSize="11" />
                            </HorizontalStackLayout>

                            <!-- Поле ввода с акцентной кнопкой -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource SurfaceAlt}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="1"
                                        Padding="10,6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Label Text="{DynamicResource s_ui_128}"
                                           TextColor="{DynamicResource TextMuted}"
                                           FontSize="12" />
                                </Border>
                                <Border Grid.Column="1"
                                        BackgroundColor="{DynamicResource Accent}"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{DynamicResource s_ui_050}"
                           Style="{DynamicResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Готовые палитры -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_ui_023}" Style="{DynamicResource H2}" />
                    <Label Text="{DynamicResource s_ui_070}"
                           Style="{DynamicResource Caption}" />
                    <VerticalStackLayout x:Name="PalettePresetsLayout" Spacing="8" />
                </VerticalStackLayout>
            </Border>

            <!-- Цвета -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="{DynamicResource s_ui_171}"
                               Style="{DynamicResource H2}" />
                        <Label Grid.Column="1"
                               x:Name="ChangedRolesLabel"
                               Style="{DynamicResource Caption}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{DynamicResource s_ui_069}"
                           Style="{DynamicResource Caption}" />
                    <VerticalStackLayout x:Name="RolesLayout" Spacing="8" />
                </VerticalStackLayout>
            </Border>

            <!-- Действия -->
            <VerticalStackLayout Spacing="8">
                <Label x:Name="UnsavedHint"
                       TextColor="{DynamicResource Warning}"
                       Style="{DynamicResource Caption}"
                       IsVisible="False" />
                <Button x:Name="SaveThemeButton"
                        Text="{DynamicResource s_ui_155}"
                        Style="{DynamicResource PrimaryButton}"
                        Clicked="OnSaveThemeClicked" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Скопировать"
                            Style="{DynamicResource SecondaryButton}"
                            Clicked="OnExportThemeClicked" />
                    <Button Grid.Column="1"
                            Text="{DynamicResource s_ui_016}"
                            Style="{DynamicResource SecondaryButton}"
                            Clicked="OnImportThemeClicked" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="{DynamicResource s_ui_198}"
                            Style="{DynamicResource GhostButton}"
                            Clicked="OnExportFileClicked" />
                    <Button Grid.Column="1"
                            Text="{DynamicResource s_ui_199}"
                            Style="{DynamicResource GhostButton}"
                            Clicked="OnImportFileClicked" />
                </Grid>
                <Button x:Name="ResetColorsButton"
                        Text="{DynamicResource s_ui_143}"
                        Style="{DynamicResource GhostButton}"
                        Clicked="OnResetColorsClicked" />
            </VerticalStackLayout>

            <!-- Мои темы -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_ui_066}" Style="{DynamicResource H2}" />
                    <VerticalStackLayout x:Name="MyThemesLayout" Spacing="8" />
                    <Label x:Name="EmptyThemesLabel"
                           Text="{DynamicResource s_ui_157}"
                           Style="{DynamicResource Caption}"
                           IsVisible="False" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
