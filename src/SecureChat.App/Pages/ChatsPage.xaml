<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Pages.ChatsPage"
             Title="{DynamicResource s_chats_title}">
    <Grid Padding="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6">

        <!-- Шапка -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2">
                <Label Text="{DynamicResource s_ui_030}"
                       Style="{DynamicResource Caption}" />
                <Label Text="{DynamicResource s_ui_148}"
                       Style="{DynamicResource Caption}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="＋"
                    Style="{DynamicResource IconButtonActive}"
                    WidthRequest="30"
                    HeightRequest="30"
                    VerticalOptions="Center"
                    Clicked="OnAddContactClicked"
                    ToolTipProperties.Text="{DynamicResource s_ui_032}" />
        </Grid>

        <!-- Статус подключения -->
        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Style="{DynamicResource Caption}"
               TextColor="{DynamicResource Danger}"
               IsVisible="False"
               LineBreakMode="WordWrap" />

        <!-- Поиск по сообщениям -->
        <SearchBar Grid.Row="2"
                   x:Name="MessageSearchEntry"
                   HeightRequest="36"
                   FontSize="13"
                   Placeholder="{DynamicResource s_ui_118}"
                   SearchButtonPressed="OnSearchMessagesPressed" />

        <!-- Вкладки списка, как папки в Telegram -->
        <ScrollView Grid.Row="4"
                    Orientation="Horizontal"
                    HeightRequest="30"
                    Margin="0">
            <HorizontalStackLayout Spacing="6">
                <Button x:Name="FolderAllButton"
                        Text="{DynamicResource s_chats_all}"
                        CommandParameter="Все"
                        Clicked="OnFolderClicked"
                        FontSize="11"
                        HeightRequest="30"
                        Padding="8,2"
                        CornerRadius="14" />
                <Button x:Name="FolderUnreadButton"
                        Text="{DynamicResource s_chats_unread}"
                        CommandParameter="Непрочитанные"
                        Clicked="OnFolderClicked"
                        FontSize="11"
                        HeightRequest="30"
                        Padding="8,2"
                        CornerRadius="14" />
                <Button x:Name="FolderMutedButton"
                        Text="{DynamicResource s_chats_muted}"
                        CommandParameter="Без звука"
                        Clicked="OnFolderClicked"
                        FontSize="11"
                        HeightRequest="30"
                        Padding="8,2"
                        CornerRadius="14" />
                <Button x:Name="FolderArchiveButton"
                        Text="{DynamicResource s_chats_archive}"
                        CommandParameter="Архив"
                        Clicked="OnFolderClicked"
                        FontSize="11"
                        HeightRequest="30"
                        Padding="8,2"
                        CornerRadius="14" />
                <!-- Пользовательские папки: чипы создаются кодом -->
                <HorizontalStackLayout x:Name="UserFolderChips" Spacing="6" />
                <Button x:Name="FolderManageButton"
                        Text="⋯"
                        Clicked="OnFoldersManageClicked"
                        FontSize="12"
                        HeightRequest="30"
                        Padding="8,2"
                        CornerRadius="14"
                        ToolTipProperties.Text="{DynamicResource s_ui_111}" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Истории: компактная лента над папками -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button x:Name="StoriesAddButton"
                    Text="＋"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    FontSize="17"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    TextColor="{DynamicResource Accent}"
                    VerticalOptions="Center"
                    Clicked="OnStoriesAddClicked" />
            <ScrollView Grid.Column="1" Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="ChatsStoriesStrip" Spacing="6" VerticalOptions="Center" />
            </ScrollView>
        </Grid>

        <!-- Список чатов -->
        <CollectionView x:Name="ConversationsView"
                        Grid.Row="5"
                        SelectionMode="Single"
                        SelectionChanged="OnConversationSelected"
                        ItemsLayout="VerticalList"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="16,20" Spacing="6" VerticalOptions="Center">
                    <Label Text="💬"
                           Style="{DynamicResource EmptyStateIcon}" />
                    <Label Text="Пока нет чатов"
                           Style="{DynamicResource EmptyStateTitle}" />
                    <Label Text="{DynamicResource s_ui_034}"
                           Style="{DynamicResource EmptyStateCaption}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource Card}" Margin="6,3" Padding="8,6">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                            <!-- Аватар -->
                            <Grid WidthRequest="40"
                                  HeightRequest="40">
                                <Border StrokeThickness="0"
                                        BackgroundColor="{DynamicResource AccentSoft}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Initial}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{DynamicResource Accent}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Image Source="{Binding AvatarSource}"
                                       Aspect="AspectFill"
                                       WidthRequest="40"
                                       HeightRequest="40">
                                    <Image.Clip>
                                        <EllipseGeometry />
                                    </Image.Clip>
                                </Image>
                            </Grid>

                            <!-- Название и превью -->
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Username}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding LastMessage}"
                                       Style="{DynamicResource Caption}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Время и счётчик непрочитанных -->
                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="4"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center">
                                <Label Text="🔇"
                                       FontSize="10"
                                       HorizontalOptions="End"
                                       IsVisible="{Binding IsMuted}" />
                                <Label Text="{Binding TimeText}"
                                       FontSize="10"
                                       TextColor="{DynamicResource TextDisabled}"
                                       HorizontalOptions="End" />
                                <Border IsVisible="{Binding HasUnread}"
                                        BackgroundColor="{DynamicResource Accent}"
                                        StrokeThickness="0"
                                        Padding="5,1"
                                        HorizontalOptions="End">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding UnreadText}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource AccentText}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Меню чата -->
                            <Button Grid.Column="3"
                                    Text="⋮"
                                    FontSize="18"
                                    Padding="4"
                                    MinimumWidthRequest="26"
                                    MinimumHeightRequest="32"
                                    Style="{DynamicResource IconButton}"
                                    VerticalOptions="Center"
                                    Clicked="OnConversationMenuClicked"
                                    ToolTipProperties.Text="{DynamicResource s_ui_029}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Нижняя панель: быстрые действия и выход -->
        <Grid Grid.Row="6"
              Padding="8,4,8,8"
              RowDefinitions="Auto,Auto"
              RowSpacing="8">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="➕"
                        FontSize="18"
                        HeightRequest="42"
                        Style="{DynamicResource IconButton}"
                        BackgroundColor="{DynamicResource SurfaceAlt}"
                        Clicked="OnAddContactClicked"
                        ToolTipProperties.Text="{DynamicResource s_ui_089}" />
                <Button Grid.Column="1"
                        Text="💬"
                        FontSize="16"
                        HeightRequest="42"
                        Style="{DynamicResource IconButton}"
                        BackgroundColor="{DynamicResource SurfaceAlt}"
                        Clicked="OnMyProfileClicked"
                        ToolTipProperties.Text="{DynamicResource s_ui_067}" />
                <Button Grid.Column="2"
                        Text="📢"
                        FontSize="16"
                        HeightRequest="42"
                        Style="{DynamicResource IconButton}"
                        BackgroundColor="{DynamicResource SurfaceAlt}"
                        Clicked="OnSpacesClicked"
                        ToolTipProperties.Text="{DynamicResource s_ui_025}" />
                <Button Grid.Column="3"
                        Text="🌐"
                        FontSize="16"
                        HeightRequest="42"
                        Style="{DynamicResource IconButton}"
                        BackgroundColor="{DynamicResource SurfaceAlt}"
                        Clicked="OnBrowserClicked"
                        ToolTipProperties.Text="{DynamicResource s_ui_017}" />
            
        
</Grid>
            <Button Grid.Row="1"
                    Text="{DynamicResource s_vs_logout}"
                    FontSize="13"
                    Style="{DynamicResource GhostButton}"
                    TextColor="{DynamicResource Danger}"
                    Clicked="OnLogoutClicked"
                    ToolTipProperties.Text="{DynamicResource s_vs_logout}" />
            <Label x:Name="HintLabel"
                   Grid.Row="4"
                   Grid.ColumnSpan="4"
                   Style="{DynamicResource Caption}"
                   TextColor="{DynamicResource TextMuted}"
                   IsVisible="False"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
