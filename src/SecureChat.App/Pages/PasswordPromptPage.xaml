<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Pages.PasswordPromptPage"
             Title="Подтверждение">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="420" VerticalOptions="Center">
            <Label x:Name="TitleLabel" Style="{DynamicResource H2}" />
            <Label x:Name="MessageLabel" Style="{DynamicResource Caption}" />
            <Entry x:Name="PasswordEntry"
                   IsPassword="True"
                   Placeholder="Пароль"
                   ReturnType="Done"
                   Completed="OnAcceptClicked" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <Button Text="Отмена"
                        Style="{DynamicResource SecondaryButton}"
                        Clicked="OnCancelClicked" />
                <Button x:Name="AcceptButton"
                        Grid.Column="1"
                        Text="Продолжить"
                        Style="{DynamicResource PrimaryButton}"
                        Clicked="OnAcceptClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
