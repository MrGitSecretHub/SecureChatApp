<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SecureChat.App.Pages"
             x:Class="SecureChat.App.Pages.SettingsPage"
             Title="{DynamicResource s_settings_title}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:ThemeNameToBackgroundColorConverter x:Key="ThemeToBgConverter" />
            <local:ThemeNameToSelectionStrokeConverter x:Key="ThemeToStrokeConverter" />
            <local:SelectedToStrokeConverter x:Key="SelectedToStrokeConverter" />
            <local:SelectedToRingConverter x:Key="SelectedToRingConverter" />
            <local:ThemeNameToThemBubbleConverter x:Key="ThemeToThemBubbleConverter" />
            <local:ThemeNameToMeBubbleConverter x:Key="ThemeToMeBubbleConverter" />

            <DataTemplate x:Key="ThemeTileTemplate" x:DataType="local:ThemeTileVm">
                <VerticalStackLayout Spacing="4" WidthRequest="92" HorizontalOptions="Center">
                    <Border x:Name="tile"
                            BackgroundColor="{Binding Name, Converter={StaticResource ThemeToBgConverter}}"
                            WidthRequest="92"
                            HeightRequest="96"
                            Padding="8"
                            StrokeThickness="2"
                            Stroke="{Binding IsSelected, Converter={StaticResource SelectedToStrokeConverter}}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid>
                            <!-- «Пузыри» превью: чужой слева, свой справа -->
                            <Border BackgroundColor="{Binding Name, Converter={StaticResource ThemeToThemBubbleConverter}}"
                                    StrokeThickness="0"
                                    WidthRequest="46"
                                    HeightRequest="13"
                                    Margin="0,10,0,0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                            </Border>
                            <Border BackgroundColor="{Binding Name, Converter={StaticResource ThemeToMeBubbleConverter}}"
                                    StrokeThickness="0"
                                    WidthRequest="34"
                                    HeightRequest="13"
                                    Margin="0,28,0,0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                            </Border>
                            <!-- Кружок выбора, как радиокнопка в Telegram -->
                            <Border WidthRequest="20"
                                    HeightRequest="20"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="2"
                                    Stroke="{Binding IsSelected, Converter={StaticResource SelectedToRingConverter}}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="End"
                                    Margin="0,0,0,2">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                            </Border>
                        </Grid>
                    </Border>
                    <Label Text="{Binding Name}"
                           FontSize="11"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           MaxLines="2"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout x:Name="SettingsContent" Padding="16" Spacing="14" MaximumWidthRequest="820">

            <!-- ============================================================
                 ПРОФИЛЬ
                 ============================================================ -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{DynamicResource s_settings_profile}" Style="{DynamicResource H2}" />

                    <!-- Аватар -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="72"
                                HeightRequest="72"
                                BackgroundColor="{DynamicResource AccentSoft}">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Image x:Name="AvatarImage"
                                   WidthRequest="68"
                                   HeightRequest="68"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="{DynamicResource s_set_007}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Button x:Name="AvatarButton"
                                    Text="{DynamicResource s_set_031}"
                                    Style="{DynamicResource SecondaryButton}"
                                    HorizontalOptions="Start"
                                    Clicked="OnAvatarClicked" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Никнейм -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_103}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Entry x:Name="NicknameEntry"
                               Placeholder="{DynamicResource s_set_058}"
                               TextChanged="OnNicknameChanged" />
                    </VerticalStackLayout>

                    <!-- Био -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_094}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Editor x:Name="BioEditor"
                                Placeholder="{DynamicResource s_set_068}"
                                PlaceholderColor="{DynamicResource TextMuted}"
                                HeightRequest="90"
                                AutoSize="TextChanges"
                                TextChanged="OnBioChanged" />
                    </VerticalStackLayout>

                    <!-- Статус -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_161}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Picker x:Name="StatusPicker"
                                SelectedIndexChanged="OnStatusChanged"
                                TextColor="{DynamicResource TextPrimary}" />
                    </VerticalStackLayout>

                    <!-- Аккаунт -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{DynamicResource s_set_052}" Style="{DynamicResource Caption}" />
                            <Label x:Name="UsernameLabel" FontSize="15" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{DynamicResource s_settings_server}" Style="{DynamicResource Caption}" HorizontalTextAlignment="End" />
                            <Label x:Name="ServerLabel" Style="{DynamicResource Caption}" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_settings_transport}" Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Picker x:Name="TransportPicker"
                                    SelectedIndexChanged="OnTransportChanged"
                                    TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label x:Name="TransportHintLabel"
                           Style="{DynamicResource Caption}"
                           TextColor="{DynamicResource Warning}"
                           LineBreakMode="CharacterWrap"
                           IsVisible="False" />

                    <!-- TCP-туннель (например, Playit): отдельный адрес и порт -->
                    <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                        <Label Text="{DynamicResource s_settings_tcp_tunnel}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label Text="{DynamicResource s_set_038}"
                               Style="{DynamicResource Caption}" />
                        <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                            <Entry x:Name="TcpHostEntry"
                                   Placeholder="{DynamicResource s_set_179}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   Keyboard="Url"
                                   TextChanged="OnTcpTunnelChanged" />
                            <Entry x:Name="TcpPortEntry"
                                   Placeholder="{DynamicResource s_set_181}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   Keyboard="Numeric"
                                   MaxLength="5"
                                   TextChanged="OnTcpTunnelChanged" />
                        </Grid>
                    </VerticalStackLayout>

                    <Label x:Name="FingerprintLabel"
                           Style="{DynamicResource Caption}"
                           LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================
                 БЕЗОПАСНОСТЬ И ПРИВАТНОСТЬ
                 ============================================================ -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_settings_privacy}" Style="{DynamicResource H2}" />

                    <!-- Отпечаток ключа -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_104}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_126}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Button x:Name="ShowFingerprintButton"
                                Text="{DynamicResource s_set_118}"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnShowFingerprintClicked" />
                    </Grid>

                    <!-- Приватность: скрыть онлайн -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_151}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_155}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="HideOnlineSwitch"
                                Toggled="OnHideOnlineToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Приватность: скрыть прочтения -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_150}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_156}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="HideReadSwitch"
                                Toggled="OnHideReadToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Приватность: индикатор набора текста -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_121}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_154}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="TypingSwitch"
                                Toggled="OnTypingToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Приватность: текст в уведомлениях -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_163}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_033}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="PreviewSwitch"
                                Toggled="OnPreviewToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Приватность: звук уведомлений -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_046}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_067}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="SoundsSwitch"
                                Toggled="OnSoundsToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Приватность: рингтон уведомлений -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_132}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_146}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Button x:Name="RingtoneButton"
                                Text="{DynamicResource s_set_145}"
                                Style="{DynamicResource SecondaryButton}"
                                MinimumWidthRequest="150"
                                VerticalOptions="Center"
                                Clicked="OnRingtoneClicked" />
                    </Grid>

                    <!-- Приватность: только контакты -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_159}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_158}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="ContactsOnlySwitch"
                                Toggled="OnContactsOnlyToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Приватность: превью ссылок -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_123}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label x:Name="LinkPreviewHintLabel"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="LinkPreviewSwitch"
                                Toggled="OnLinkPreviewToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Код-пароль приложения -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_062}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_044}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Button x:Name="ChangePasswordButton"
                                Text="{DynamicResource s_set_060}"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnChangePasswordClicked" />
                    </Grid>

                    <!-- Заблокированные пользователи -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{DynamicResource s_set_039}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label Text="{DynamicResource s_set_157}"
                               Style="{DynamicResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="BlockEntry"
                                   Placeholder="{DynamicResource s_set_052}" />
                            <Button x:Name="BlockButton"
                                    Grid.Column="1"
                                    Text="{DynamicResource s_set_040}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Clicked="OnBlockClicked" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Picker x:Name="BlockedPicker"
                                    Title="{DynamicResource s_set_160}" />
                            <Button x:Name="UnblockButton"
                                    Grid.Column="1"
                                    Text="{DynamicResource s_set_130}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Clicked="OnUnblockClicked" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Резервная копия ключей -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{DynamicResource s_backup_title}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label Text="{DynamicResource s_backup_hint}" Style="{DynamicResource Caption}" />
                        <Entry x:Name="BackupPasswordEntry"
                               Placeholder="{DynamicResource s_backup_password}"
                               IsPassword="True" />
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="ExportKeysButton"
                                    Text="{DynamicResource s_backup_export}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Clicked="OnExportKeysClicked" />
                            <Button x:Name="ImportKeysButton"
                                    Text="{DynamicResource s_backup_import}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Clicked="OnImportKeysClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Экспорт / импорт истории -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{DynamicResource s_set_071}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label Text="{DynamicResource s_set_178}"
                               Style="{DynamicResource Caption}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="ExportHistoryButton"
                                    Text="{DynamicResource s_set_177}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Clicked="OnExportHistoryClicked" />
                            <Button x:Name="ImportHistoryButton"
                                    Text="{DynamicResource s_set_051}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Clicked="OnImportHistoryClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================
                 СЕРВЕР
                 ============================================================ -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_settings_server}" Style="{DynamicResource H2}" />
                    <Label Text="{DynamicResource s_set_012}"
                           Style="{DynamicResource Caption}" />
                    <Button Text="{DynamicResource s_set_125}"
                            Style="{DynamicResource SecondaryButton}"
                            HorizontalOptions="Start"
                            Clicked="OnCheckServerClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================
                 УПРАВЛЕНИЕ АККАУНТОМ
                 ============================================================ -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_set_013}" Style="{DynamicResource H2}" />
                    <Button Text="{DynamicResource s_set_153}"
                            Style="{DynamicResource SecondaryButton}"
                            Clicked="OnChangeAccountPasswordClicked" />
                    <Button Text="{DynamicResource s_set_032}"
                            Style="{DynamicResource SecondaryButton}"
                            Clicked="OnLogoutClicked" />
                    <Button Text="{DynamicResource s_set_169}"
                            Style="{DynamicResource DangerButton}"
                            Clicked="OnDeleteClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================
                 ОФОРМЛЕНИЕ
                 ============================================================ -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="{DynamicResource s_settings_appearance}" Style="{DynamicResource H2}" />

                    <!-- Тема: плитки, как в Telegram -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{DynamicResource s_settings_theme}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <!-- Тема: плитки, как в Telegram (горизонтальная прокрутка) -->
                        <CollectionView x:Name="ThemeCollectionView"
                                        ItemsLayout="HorizontalList"
                                        SelectionMode="Single"
                                        SelectionChanged="OnThemeSelected"
                                        ItemTemplate="{StaticResource ThemeTileTemplate}" />
                        <Button x:Name="ShowAllThemesButton"
                                Text="{DynamicResource s_set_117}"
                                Style="{DynamicResource GhostButton}"
                                HorizontalOptions="Start"
                                Clicked="OnShowAllThemesClicked" />
                        <!-- Скрытый Picker оставлен для совместимости кода инициализации -->
                        <Picker x:Name="ThemePicker"
                                IsVisible="False"
                                SelectedIndexChanged="OnThemeChanged"
                                TextColor="{DynamicResource TextPrimary}" />
                    </VerticalStackLayout>

                    <!-- Свои цвета и свои темы -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{DynamicResource s_set_138}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label x:Name="CustomThemeLabel"
                               Style="{DynamicResource Caption}" />
                        <VerticalStackLayout x:Name="CustomThemesLayout" Spacing="6" />
                        <Button x:Name="ThemeEditorButton"
                                Text="{DynamicResource s_set_182}"
                                Style="{DynamicResource GhostButton}"
                                HorizontalOptions="Start"
                                Clicked="OnThemeEditorClicked" />
                    </VerticalStackLayout>

                    <!-- Язык интерфейса -->
                    <VerticalStackLayout Spacing="4" Margin="0,10,0,0">
                        <Label Text="{DynamicResource s_settings_language}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label Text="{DynamicResource s_settings_language_hint}" Style="{DynamicResource Caption}" />
                        <Picker x:Name="LanguagePicker"
                                SelectedIndexChanged="OnLanguageChanged"
                                TextColor="{DynamicResource TextPrimary}" />
                    </VerticalStackLayout>

                    <Label Text="{DynamicResource s_settings_theme}" Style="{DynamicResource SectionTitle}" Margin="0,10,0,0" />

                    <!-- Цвет вашего имени -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{DynamicResource s_set_175}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label Text="{DynamicResource s_set_025}"
                               Style="{DynamicResource Caption}" />
                        <HorizontalStackLayout x:Name="NameColorRow" Spacing="10" />
                    </VerticalStackLayout>

                    <!-- Авто-ночной режим -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_010}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_093}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="AutoNightSwitch"
                                Toggled="OnAutoNightToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Шрифт сообщений -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_176}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Picker x:Name="MessageFontPicker"
                                SelectedIndexChanged="OnMessageFontChanged"
                                TextColor="{DynamicResource TextPrimary}" />
                    </VerticalStackLayout>

                    <!-- Акцентный цвет -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{DynamicResource s_set_014}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label x:Name="AccentNameLabel"
                               Style="{DynamicResource Caption}" />
                        <HorizontalStackLayout x:Name="AccentRow" Spacing="10" />
                        <Button x:Name="AccentPickerButton"
                                Text="{DynamicResource s_set_183}"
                                Style="{DynamicResource GhostButton}"
                                HorizontalOptions="Start"
                                Clicked="OnAccentPickerClicked" />
                    </VerticalStackLayout>

                    <!-- Форма пузырей -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_174}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Picker x:Name="BubbleShapePicker"
                                SelectedIndexChanged="OnBubbleShapeChanged"
                                TextColor="{DynamicResource TextPrimary}" />
                    </VerticalStackLayout>

                    <!-- Аватары в переписке -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_008}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_119}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="AvatarsSwitch"
                                Toggled="OnAvatarsToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Время у сообщений -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_028}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_120}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="TimestampsSwitch"
                                Toggled="OnTimestampsToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Компактный список чатов -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_066}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_015}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="CompactSidebarSwitch"
                                Toggled="OnCompactSidebarToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Подключение -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_115}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Label Text="{DynamicResource s_set_128}"
                               Style="{DynamicResource Caption}" />
                        <Label x:Name="TransportLabel"
                               Style="{DynamicResource Caption}" />
                    </VerticalStackLayout>

                    <!-- Размер шрифта -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_131}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Picker x:Name="FontScalePicker"                                SelectedIndexChanged="OnFontScaleChanged"
                                TextColor="{DynamicResource TextPrimary}" />
                    </VerticalStackLayout>

                    <!-- Плотность -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_set_112}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Picker x:Name="DensityPicker"                                SelectedIndexChanged="OnDensityChanged"
                                TextColor="{DynamicResource TextPrimary}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ============================================================
                 ОБОИ ЧАТА
                 ============================================================ -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{DynamicResource s_set_095}" Style="{DynamicResource H2}" />

                    <Border x:Name="WallpaperPreview"
                            HeightRequest="110"
                            WidthRequest="190"
                            HorizontalOptions="Start"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid BackgroundColor="{DynamicResource SurfaceAlt}">
                            <Image x:Name="WallpaperPreviewImage"
                                   Aspect="AspectFill" />
                            <Label x:Name="WallpaperEmptyLabel"
                                   Text="🖼"
                                   FontSize="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{DynamicResource s_set_048}"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnWallpaperGalleryClicked" />
                        <Button Text="{DynamicResource s_set_049}"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnWallpaperFileClicked" />
                        <Button x:Name="RemoveWallpaperButton"
                                Text="{DynamicResource s_set_167}"
                                Style="{DynamicResource GhostButton}"
                                IsVisible="False"
                                Clicked="OnWallpaperRemoveClicked" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource s_set_045}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_122}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="WallpaperDimSwitch"
                                Toggled="OnWallpaperDimToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ============================================================
                 МЕДИА И ПАМЯТЬ
                 ============================================================ -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{DynamicResource s_set_075}" Style="{DynamicResource H2}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{DynamicResource s_set_043}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label x:Name="MediaCacheLabel"
                                   Text="{DynamicResource s_set_162}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                x:Name="ClearMediaCacheButton"
                                Text="{DynamicResource s_set_100}"
                                Style="{DynamicResource SecondaryButton}"
                                VerticalOptions="Center"
                                Clicked="OnClearMediaCacheClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{DynamicResource s_set_011}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_set_006}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Picker x:Name="AutoDownloadPicker"
                                Grid.Column="1"
                                SelectedIndexChanged="OnAutoDownloadChanged"
                                VerticalOptions="Center"
                                TextColor="{DynamicResource TextPrimary}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="{DynamicResource s_set_001}"
                   Style="{DynamicResource Caption}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>