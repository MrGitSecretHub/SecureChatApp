<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Pages.GlobalSearchPage"
             Title="{DynamicResource s_ui_120}">
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <SearchBar x:Name="SearchEntry"
                   Placeholder="{DynamicResource s_ui_118}"
                   TextChanged="OnSearchTextChanged"
                   SearchButtonPressed="OnSearchPressed" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Picker x:Name="SenderPicker" Grid.Column="0" Title="{DynamicResource s_search_all}" />
            <Picker x:Name="TypePicker" Grid.Column="1" Title="{DynamicResource s_search_all_types}" />
            <Picker x:Name="DatePicker" Grid.Column="2" Title="{DynamicResource s_search_any_time}" />
        </Grid>

        <Label x:Name="HintLabel"
               Grid.Row="2"
               Text="{DynamicResource s_ui_010}"
               Style="{DynamicResource Caption}" />

        <CollectionView x:Name="ResultsView"
                        Grid.Row="3"
                        SelectionMode="Single"
                        SelectionChanged="OnResultSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Style="{DynamicResource EmptyStateCard}">
                    <Label Text="🔍"
                           Style="{DynamicResource EmptyStateIcon}" />
                    <Label Text="{DynamicResource s_ui_087}"
                           Style="{DynamicResource EmptyStateTitle}" />
                    <Label Text="{DynamicResource s_ui_117}"
                           Style="{DynamicResource EmptyStateCaption}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource Card}" Margin="0,4" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                       Text="{Binding TimeText}"
                                       Style="{DynamicResource Caption}" />
                            </Grid>
                            <Label Text="{Binding Preview}"
                                   Style="{DynamicResource Caption}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
