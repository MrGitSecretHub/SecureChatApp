<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             Title="SecureChat">
    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*">
            <VerticalStackLayout Grid.Row="1"
                                 Spacing="16"
                                 MaximumWidthRequest="460"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="SecureChat"
                       FontSize="42"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource Accent}"
                       HorizontalOptions="Center" />
                <Label Text="{DynamicResource s_login_subtitle}"
                       FontSize="13"
                       TextColor="{DynamicResource Muted}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <Border Style="{DynamicResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{DynamicResource s_login_server}" Style="{DynamicResource FieldLabel}" />
                        <Entry x:Name="ServerEntry"
                               Placeholder="{DynamicResource s_login_server_placeholder}"
                               Keyboard="Url"
                               ClearButtonVisibility="WhileEditing" />
                        <Label x:Name="ServerHintLabel"
                               Text="{DynamicResource s_login_server_hint}"
                               Style="{DynamicResource Caption}"
                               TextColor="{DynamicResource Accent}"
                               LineBreakMode="WordWrap">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnServerHintTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="InsecureHttpCheck" VerticalOptions="Center" />
                            <Label Text="{DynamicResource s_login_insecure_check}"
                                   Style="{DynamicResource Caption}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="{DynamicResource s_login_username}" Style="{DynamicResource FieldLabel}" />
                        <Entry x:Name="UsernameEntry"
                               Placeholder="alice"
                               IsSpellCheckEnabled="False"
                               MaxLength="32" />

                        <Label Text="{DynamicResource s_login_email}" Style="{DynamicResource FieldLabel}" />
                        <Entry x:Name="EmailEntry"
                               Placeholder="alice@example.com"
                               Keyboard="Email"
                               IsSpellCheckEnabled="False" />

                        <Label Text="{DynamicResource s_login_password}" Style="{DynamicResource FieldLabel}" />
                        <Entry x:Name="PasswordEntry"
                               Placeholder="{DynamicResource s_login_003}"
                               IsPassword="True" />

                        <Label Text="{DynamicResource s_login_password_repeat}" Style="{DynamicResource FieldLabel}" />
                        <Entry x:Name="ConfirmEntry"
                               Placeholder="{DynamicResource s_login_006}"
                               IsPassword="True" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button x:Name="LoginButton"
                                    Text="{DynamicResource s_login_signin}"
                                    Clicked="OnLoginClicked" />
                            <Button x:Name="RegisterButton"
                                    Grid.Column="1"
                                    Text="{DynamicResource s_login_register}"
                                    Style="{DynamicResource SecondaryButton}"
                                    Clicked="OnRegisterClicked" />
                        </Grid>

                        <ActivityIndicator x:Name="BusyIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="{DynamicResource Accent}" />

                        <Label x:Name="StatusLabel"
                               FontSize="13"
                               TextColor="{DynamicResource Danger}"
                               IsVisible="False"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{DynamicResource s_login_note}"
                       FontSize="11"
                       TextColor="{DynamicResource Muted}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
