<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SecureChat.App.Views"
             x:Class="SecureChat.App.Pages.SpaceSettingsPage"
             Title="{DynamicResource s_ui_079}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="760">

            <!-- Основное -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{DynamicResource s_ui_136}" Style="{DynamicResource H2}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{DynamicResource AccentSoft}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Label x:Name="SpaceIconLabel"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label x:Name="SpaceNameLabel"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="SpaceTypeLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_ui_072}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Entry x:Name="NameEntry" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_ui_094}" Style="{DynamicResource SectionTitle}" Margin="0" />
                        <Editor x:Name="DescriptionEditor"
                                HeightRequest="80"
                                AutoSize="TextChanges"
                                Placeholder="{DynamicResource s_ui_061}"
                                PlaceholderColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>

                    <!-- Публичность -->
                    <Grid x:Name="PublicRow"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          IsVisible="False">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{DynamicResource s_ui_139}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_ui_011}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="PublicSwitch"
                                Grid.Column="1"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Скрытие из поиска: только для публичных пространств -->
                    <Grid x:Name="HiddenRow"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          IsVisible="False">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{DynamicResource s_spaces_hidden_title}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_spaces_hidden_hint}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="HiddenSwitch"
                                Grid.Column="1"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Подписи постов: только для каналов -->
                    <Grid x:Name="SignRow"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          IsVisible="False">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{DynamicResource s_ui_114}" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="{DynamicResource s_ui_126}"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="SignSwitch"
                                Grid.Column="1"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>

                    <Button Text="Сохранить"
                            Style="{DynamicResource PrimaryButton}"
                            Clicked="OnSaveClicked" />
                    <Button x:Name="RotateKeyButton"
                            Text="{DynamicResource s_key_rotate}"
                            Style="{DynamicResource SecondaryButton}"
                            IsVisible="False"
                            Clicked="OnRotateKeyClicked" />
                    <Button x:Name="DistributeKeyButton"
                            Text="🔑 Раздать ключ всем"
                            Style="{DynamicResource SecondaryButton}"
                            IsVisible="False"
                            Clicked="OnDistributeKeyClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Участники -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_ui_168}" Style="{DynamicResource H2}" />
                    <Label x:Name="ErrorLabel"
                           TextColor="{DynamicResource Warning}"
                           Style="{DynamicResource Caption}"
                           IsVisible="False" />
                    <Label x:Name="MembersHintLabel"
                           Style="{DynamicResource Caption}" />

                    <CollectionView x:Name="MembersView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnMemberTapped"
                                    HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="views:MemberRow">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding HeaderText}"
                                           IsVisible="{Binding IsHeaderRow}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextDisabled}"
                                           Padding="8,10,8,2" />
                                    <Grid Padding="8,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                                          IsVisible="{Binding IsMemberRow}">
                                    <Border WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="{Binding AvatarColor}">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Initial}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Username}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="{Binding StatusText}"
                                               FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding RoleText}"
                                               FontSize="11"
                                               TextColor="{DynamicResource Accent}" />
                                        <Label Text="{Binding CanPostText}"
                                               FontSize="10"
                                               TextColor="{DynamicResource TextDisabled}" />
                                    </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{DynamicResource s_ui_033}"
                            Style="{DynamicResource SecondaryButton}"
                            Clicked="OnAddMemberClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Обои пространства -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_ui_092}" Style="{DynamicResource H2}" />

                    <Border x:Name="SpaceWallpaperPreview"
                            HeightRequest="110"
                            WidthRequest="190"
                            HorizontalOptions="Start"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid BackgroundColor="{DynamicResource SurfaceAlt}">
                            <Image x:Name="SpaceWallpaperPreviewImage"
                                   Aspect="AspectFill" />
                            <Label x:Name="SpaceWallpaperEmptyLabel"
                                   Text="🖼"
                                   FontSize="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Из галереи"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnSpaceWallpaperGalleryClicked" />
                        <Button Text="Из файла"
                                Style="{DynamicResource SecondaryButton}"
                                Clicked="OnSpaceWallpaperFileClicked" />
                        <Button x:Name="SpaceWallpaperRemoveButton"
                                Text="Убрать"
                                Style="{DynamicResource GhostButton}"
                                IsVisible="False"
                                Clicked="OnSpaceWallpaperRemoveClicked" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Затемнять обои" Style="{DynamicResource SectionTitle}" Margin="0" />
                            <Label Text="Полупрозрачная вуаль поверх картинки для читабельности"
                                   Style="{DynamicResource Caption}" />
                        </VerticalStackLayout>
                        <Switch x:Name="SpaceWallpaperDimSwitch"
                                Toggled="OnSpaceWallpaperDimToggled"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Опасная зона -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource s_ui_028}" Style="{DynamicResource H2}" />
                    <Button x:Name="LeaveButton"
                            Text="{DynamicResource s_ui_127}"
                            Style="{DynamicResource SecondaryButton}"
                            Clicked="OnLeaveClicked" />
                    <Button x:Name="DeleteButton"
                            Text="{DynamicResource s_ui_167}"
                            Style="{DynamicResource DangerButton}"
                            Clicked="OnDeleteClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
