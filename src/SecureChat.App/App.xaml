<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ============================================================
                 ЦВЕТОВАЯ ПАЛИТРА (Telegram-стиль, тёмная тема по умолчанию)
                 ============================================================ -->
            <Color x:Key="PageBackground">#000000</Color>
            <Color x:Key="Surface">#1a1a1a</Color>
            <Color x:Key="SurfaceAlt">#252525</Color>
            <Color x:Key="SurfaceHover">#333333</Color>
            <Color x:Key="BorderColor">#333333</Color>
            <Color x:Key="BorderHover">#444444</Color>

            <Color x:Key="TextPrimary">#ffffff</Color>
            <Color x:Key="TextSecondary">#b3b3b3</Color>
            <Color x:Key="TextMuted">#808080</Color>
            <Color x:Key="TextDisabled">#666666</Color>

            <!-- Светлая тема -->
            <Color x:Key="LightPageBackground">#ffffff</Color>
            <Color x:Key="LightSurface">#f0f0f0</Color>
            <Color x:Key="LightSurfaceAlt">#e5e5e5</Color>
            <Color x:Key="LightSurfaceHover">#d9d9d9</Color>
            <Color x:Key="LightBorderColor">#cccccc</Color>
            <Color x:Key="LightBorderHover">#bbbbbb</Color>

            <Color x:Key="LightTextPrimary">#000000</Color>
            <Color x:Key="LightTextSecondary">#595959</Color>
            <Color x:Key="LightTextMuted">#808080</Color>
            <Color x:Key="LightTextDisabled">#a6a6a6</Color>

            <!-- Акцент Telegram (синий) -->
            <Color x:Key="Accent">#0088cc</Color>
            <Color x:Key="AccentHover">#0077b3</Color>
            <Color x:Key="AccentSoft">#0088cc1a</Color>
            <Color x:Key="AccentText">#ffffff</Color>

            <Color x:Key="Success">#00aa00</Color>
            <Color x:Key="SuccessSoft">#00aa001a</Color>
            <Color x:Key="Danger">#ff4444</Color>
            <Color x:Key="DangerSoft">#ff44441a</Color>
            <Color x:Key="Warning">#ffaa00</Color>

            <!-- Пузыри сообщений -->
            <Color x:Key="MessageMe">#0088cc</Color>
            <Color x:Key="MessageMeText">#ffffff</Color>
            <Color x:Key="MessageThem">#2a2a2a</Color>
            <Color x:Key="MessageThemText">#ffffff</Color>

            <Color x:Key="UnreadDot">#ff4444</Color>
            <Color x:Key="OnlineDot">#00aa00</Color>
            <Color x:Key="OfflineDot">#666666</Color>

            <Color x:Key="Muted">#808080</Color>
            <Color x:Key="SelectionOverlay">#0088cc33</Color>

            <!-- Размеры шрифта -->
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeMessage">15</x:Double>
            <x:Double x:Key="FontSizeTitle">16</x:Double>
            <x:Double x:Key="FontSizeHeading">20</x:Double>

            <!-- Плотность сообщений (Telegram: компактно) -->
            <Thickness x:Key="BubblePadding">10,7</Thickness>
            <Thickness x:Key="MessageRowPadding">12,3</Thickness>

            <!-- ШРИФТЫ -->
            <OnPlatform x:Key="FontFamilyRegular" x:TypeArguments="x:String">
                <On Platform="Windows">Segoe UI Variable</On>
                <On Platform="Android">sans-serif</On>
                <On Platform="iOS">SF Pro Text</On>
            </OnPlatform>
            <OnPlatform x:Key="FontFamilyBold" x:TypeArguments="x:String">
                <On Platform="Windows">Segoe UI Variable Bold</On>
                <On Platform="Android">sans-serif-medium</On>
                <On Platform="iOS">SF Pro Text Semibold</On>
            </OnPlatform>
            <OnPlatform x:Key="FontFamilyMono" x:TypeArguments="x:String">
                <On Platform="Windows">Consolas</On>
                <On Platform="Android">monospace</On>
                <On Platform="iOS">Menlo</On>
            </OnPlatform>

            <!-- ============================================================
                 СТИЛИ СТРАНИЦ
                 ============================================================ -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
            </Style>

            <!-- ============================================================
                 ЛЕЙБЛЫ
                 ============================================================ -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="H1" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
            </Style>

            <Style x:Key="H2" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
            </Style>

            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
            </Style>

            <Style x:Key="Timestamp" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
            </Style>

            <!-- ============================================================
                 КНОПКИ
                 ============================================================ -->
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinimumHeightRequest" Value="40" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Danger}" />
                <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBold}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="MinimumHeightRequest" Value="36" />
                <Setter Property="MinimumWidthRequest" Value="36" />
            </Style>

            <Style x:Key="IconButtonActive" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="MinimumHeightRequest" Value="36" />
                <Setter Property="MinimumWidthRequest" Value="36" />
            </Style>

            <!-- ============================================================
                 ПОЛЯ ВВОДА
                 ============================================================ -->
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            </Style>

            <!-- ============================================================
                 КАРТОЧКИ / ГРАНИЦЫ
                 ============================================================ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="CardHover" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceHover}" />
                <Setter Property="Stroke" Value="{DynamicResource BorderHover}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SidebarItem" TargetType="Border">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style x:Key="SidebarItemActive" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>

            <!-- ============================================================
                 АВАТАРЫ
                 ============================================================ -->
            <Style x:Key="Avatar" TargetType="Image">
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="AvatarSmall" TargetType="Image">
                <Setter Property="WidthRequest" Value="32" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="AvatarTiny" TargetType="Image">
                <Setter Property="WidthRequest" Value="24" />
                <Setter Property="HeightRequest" Value="24" />
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>

            <Style x:Key="AvatarBorder" TargetType="Border">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="StrokeShape" Value="Ellipse" />
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="Padding" Value="2" />
            </Style>

            <!-- ============================================================
                 СООБЩЕНИЯ (Telegram-стиль пузырей)
                 ============================================================ -->
            <Style x:Key="MessageBubbleMe" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource MessageMe}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16,16,0,16" />
                <Setter Property="Padding" Value="{DynamicResource BubblePadding}" />
                <Setter Property="MaximumWidthRequest" Value="280" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="Margin" Value="56,0,8,2" />
            </Style>

            <Style x:Key="MessageBubbleThem" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource MessageThem}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16,16,16,0" />
                <Setter Property="Padding" Value="{DynamicResource BubblePadding}" />
                <Setter Property="MaximumWidthRequest" Value="280" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="Margin" Value="8,0,56,2" />
            </Style>

            <Style x:Key="MessageTextMe" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource MessageMeText}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeMessage}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMessage}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="MessageTextThem" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource MessageThemText}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeMessage}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMessage}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="MessageMeta" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
            </Style>

            <!-- ============================================================
                 ВСПЛЫВАЮЩИЕ ПОДСКАЗКИ / ХИНТЫ
                 ============================================================ -->
            <Style x:Key="ToastHint" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
            </Style>

            <Style x:Key="EmptyState" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <!-- Иконка пустого состояния: крупный эмодзи по центру -->
            <Style x:Key="EmptyStateIcon" TargetType="Label">
                <Setter Property="FontSize" Value="46" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- Заголовок пустого состояния -->
            <Style x:Key="EmptyStateTitle" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <!-- Подпись пустого состояния -->
            <Style x:Key="EmptyStateCaption" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <!-- ============================================================
                 ИКОНКИ ДЕЙСТВИЙ ПРИ СВАЙПЕ (Telegram-стиль)
                 ============================================================ -->
            <Style x:Key="SwipeActionButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinimumHeightRequest" Value="40" />
                <Setter Property="MinimumWidthRequest" Value="40" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <!-- ============================================================
                 УНИКАЛЬНЫЕ ЭЛЕМЕНТЫ ДЛЯ ПК-ВЕРСИИ
                 ============================================================ -->

            <!-- Значок непрочитанных сообщений в сайдбаре -->
            <Style x:Key="UnreadBadge" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource AccentText}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="WidthRequest" Value="22" />
                <Setter Property="HeightRequest" Value="22" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>

            <!-- Заголовок секции (например, "Закреплённые") -->
            <Style x:Key="SectionHeader" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="Margin" Value="16,8,16,4" />
            </Style>

            <!-- Индикатор статуса доставки (галочки) -->
            <Style x:Key="DeliveryDots" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
                <Setter Property="LineBreakMode" Value="NoWrap" />
            </Style>

            <!-- Подпись "изменено" под сообщением -->
            <Style x:Key="EditedLabel" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamilyRegular}" />
                <Setter Property="LineBreakMode" Value="NoWrap" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

