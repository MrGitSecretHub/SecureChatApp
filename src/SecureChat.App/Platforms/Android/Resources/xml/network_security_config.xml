<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- По умолчанию — только HTTPS. Сервер поднимает HTTPS на порту 5443
       с самоподписанным LAN-сертификатом (tools/New-LanTlsCertificate.ps1),
       поэтому добавляем его в доверенные корни приложения. -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="@raw/lan_tls" />
    </trust-anchors>
  </base-config>

  <!-- Локальная разработка на эмуляторе: адреса 10.0.2.2 и localhost
       остаются по HTTP, чтобы отлаживать сервер без сертификата. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
