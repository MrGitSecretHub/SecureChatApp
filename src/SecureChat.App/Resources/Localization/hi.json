  "login_register": "\u092a\u0902\u091c\u0940\u0915\u0930\u0923",
  "login_note": "ECDH \u0914\u0930 ECDSA \u0915\u0941\u0902\u091c\u093f\u092f\u093e\u0901 \u0907\u0938\u0940 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u092c\u0928\u0924\u0940 \u0939\u0948\u0902\u0964 \u0928\u093f\u091c\u0940 \u0915\u0941\u0902\u091c\u093f\u092f\u093e\u0901 \u0921\u093f\u0935\u093e\u0907\u0938 \u0928\u0939\u0940\u0902 \u091b\u094b\u0921\u093c\u0924\u0940\u0902\u0964",
  "login_error_server": "\u0938\u0930\u094d\u0935\u0930 \u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902: \u0921\u094b\u092e\u0947\u0928 \u092f\u093e IP_with \u092a\u094b\u0930\u094d\u091f\u0964 \u0938\u094d\u0915\u0940\u092e (http:// \u092f\u093e https://) \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0939\u0948\u0964",
  "login_error_username": "\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e: 3\u201332 \u0905\u0915\u094d\u0937\u0930, \u0915\u0947\u0935\u0932 \u0932\u0948\u091f\u093f\u0928 \u0905\u0915\u094d\u0937\u0930, \u0905\u0902\u0915 \u0914\u0930 \u00ab_\u00bb\u0964",
  "login_error_password": "\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u092e \u0938\u0947 \u0915\u092e 8 \u0905\u0915\u094d\u0937\u0930\u094b\u0902 \u0915\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",
