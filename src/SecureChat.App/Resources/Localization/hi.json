  "login_title": "SecureChat",
  "login_subtitle": "\u090f\u0902\u0921-\u091f\u0942-\u090f\u0902\u0921 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928\u0964 \u0938\u0930\u094d\u0935\u0930 \u0915\u0947\u0935\u0932 \u0938\u093e\u0902\u0915\u0947\u0924\u093f\u0915 \u0921\u0947\u091f\u093e \u092d\u0947\u091c\u0924\u093e \u0939\u0948, \u0906\u092a\u0915\u0947 \u0938\u0902\u0926\u0947\u0936 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0924\u093e\u0964",
