  "login_register": "\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628",
  "login_note": "\u064a\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0645\u0641\u0627\u062a\u064a\u062d ECDH \u0648 ECDSA \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632. \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u062e\u0627\u0635\u0629 \u0644\u0627 \u062a\u063a\u0627\u062f\u0631 \u0627\u0644\u062c\u0647\u0627\u0632 \u0623\u0628\u062f\u0627\u064b.",
  "login_error_server": "\u0623\u062f\u062e\u0644 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062e\u0627\u062f\u0645: \u0646\u0637\u0627\u0642 \u0623\u0648 IP \u0645\u0639 \u0645\u0646\u0641\u0630. \u0627\u0644\u0645\u062e\u0637\u0637 (http:// \u0623\u0648 https://) \u0627\u062e\u062a\u064a\u0627\u0631\u064a.",
  "login_error_username": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645: 3\u201332 \u062d\u0631\u0641\u0627\u064b\u060c \u0623\u062d\u0631\u0641 \u0644\u0627\u062a\u064a\u0646\u064a\u0629 \u0648\u0623\u0631\u0642\u0627\u0645 \u0648\u00ab_\u00bb \u0641\u0642\u0637.",
  "login_error_password": "\u064a\u062c\u0628 \u0623\u0646 \u062a\u062d\u062a\u0648\u064a \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0644\u0649 8 \u0623\u062d\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644.",
