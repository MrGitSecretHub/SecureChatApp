  "login_title": "SecureChat",
  "login_subtitle": "\u062a\u0634\u0641\u064a\u0631 \u0645\u0646 \u0637\u0631\u0641 \u0625\u0644\u0649 \u0637\u0631\u0641. \u0627\u0644\u062e\u0627\u062f\u0645 \u064a\u0646\u0642\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0634\u0641\u0631\u0629 \u0641\u0642\u0637 \u0648\u0644\u0627 \u064a\u0631\u0649 \u0631\u0633\u0627\u0626\u0644\u0643.",
  "login_server": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062e\u0627\u062f\u0645",
  "login_server_placeholder": "\u0627\u0644\u0646\u0637\u0627\u0642 \u0623\u0648 IP:\u0627\u0644\u0645\u0646\u0641\u0630 (\u0627\u0644\u0645\u062e\u0637\u0637 \u0627\u062e\u062a\u064a\u0627\u0631\u064a)",
  "login_server_hint": "\u0627\u0644\u0647\u0627\u062a\u0641 \u0623\u0648 \u0627\u0644\u0645\u062d\u0627\u0643\u064a: \u0627\u0636\u063a\u0637 \u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0639\u0646\u0648\u0627\u0646",
