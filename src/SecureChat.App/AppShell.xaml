<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:SecureChat.App.Pages"
       x:Class="SecureChat.App.AppShell"
       Title="SecureChat"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{DynamicResource Surface}">
    <Shell.ItemTemplate>
        <DataTemplate>
            <ViewCell>
                <Grid Padding="18,12" ColumnSpacing="12">
                    <Label Text="{Binding Title}"
                           FontSize="15"
                           TextColor="{DynamicResource TextPrimary}"
                           VerticalOptions="Center" />
                </Grid>
            </ViewCell>
        </DataTemplate>
    </Shell.ItemTemplate>
    <Shell.FlyoutHeader>
        <Grid Padding="20,32,20,20" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
              BackgroundColor="{DynamicResource Surface}">
            <Label Text="SecureChat"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Accent}" />
            <Label x:Name="UserLabel"
                   Grid.Row="1"
                   FontSize="15"
                   FontAttributes="Bold" />
            <Label x:Name="FingerprintLabel"
                   Grid.Row="2"
                   FontSize="10"
                   TextColor="{DynamicResource Muted}"
                   LineBreakMode="CharacterWrap" />
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="{DynamicResource s_chats_title}" Route="chats">
        <ShellContent ContentTemplate="{DataTemplate pages:ChatsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="{DynamicResource s_ui_059}" Route="contacts">
        <ShellContent ContentTemplate="{DataTemplate pages:ContactsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="{DynamicResource s_ui_122}" Route="search-users">
        <ShellContent ContentTemplate="{DataTemplate pages:SearchUsersPage}" />
    </FlyoutItem>
    <FlyoutItem Title="{DynamicResource s_common_settings}" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </FlyoutItem>
</Shell>
