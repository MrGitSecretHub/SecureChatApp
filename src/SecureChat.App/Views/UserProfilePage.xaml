<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Views.UserProfilePage"
             Title="Профиль">
    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{DynamicResource PageBackground}">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Шапка профиля -->
                <Border Style="{DynamicResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="4" WidthRequest="84">
                                <Grid WidthRequest="84" HeightRequest="84">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{DynamicResource AccentSoft}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="42" />
                                        </Border.StrokeShape>
                                        <Label x:Name="InitialLabel"
                                               Text="?"
                                               FontSize="34"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource Accent}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <Image x:Name="AvatarImage"
                                           Aspect="AspectFill"
                                           WidthRequest="84"
                                           HeightRequest="84">
                                        <Image.Clip>
                                            <EllipseGeometry />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Button x:Name="AvatarPrevButton"
                                            Text="‹" FontSize="18" Padding="0"
                                            WidthRequest="28" HeightRequest="28"
                                            Style="{DynamicResource GhostButton}"
                                            IsVisible="False"
                                            Clicked="OnAvatarPrevClicked" />
                                    <Label x:Name="AvatarCounterLabel"
                                           FontSize="11"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center"
                                           IsVisible="False" />
                                    <Button x:Name="AvatarNextButton"
                                            Text="›" FontSize="18" Padding="0"
                                            WidthRequest="28" HeightRequest="28"
                                            Style="{DynamicResource GhostButton}"
                                            IsVisible="False"
                                            Clicked="OnAvatarNextClicked" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4"
                                                 VerticalOptions="Center">
                                <Label x:Name="NicknameLabel"
                                       Text="…"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="UsernameLabel"
                                       Text="@…"
                                       FontSize="14"
                                       TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="6">
                                    <Border x:Name="StatusDot"
                                            WidthRequest="10"
                                            HeightRequest="10"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label x:Name="StatusLabel"
                                           Text="Загрузка…"
                                           FontSize="12"
                                           TextColor="{DynamicResource TextMuted}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- О себе -->
                        <VerticalStackLayout x:Name="BioSection" Spacing="2" IsVisible="False">
                            <Label Text="О себе"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label x:Name="BioLabel"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Отпечаток ключа -->
                <Border x:Name="FingerprintCard"
                        Style="{DynamicResource Card}"
                        Padding="14"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{DynamicResource s_ui_107}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}" />
                        <Label x:Name="FingerprintLabel"
                               Text="…"
                               FontSize="13"
                               TextColor="{DynamicResource TextPrimary}" />
                        <Label Text="{DynamicResource s_ui_144}"
                               FontSize="11"
                               TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="ErrorLabel"
                       Text=""
                       FontSize="12"
                       TextColor="{DynamicResource Danger}"
                       IsVisible="False"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Действие: начать чат -->
        <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="16,0,16,16">
            <Button x:Name="StartChatButton"
                    Text="{DynamicResource s_ui_196}"
                    Style="{DynamicResource PrimaryButton}"
                    HeightRequest="46"
                    Clicked="OnStartChatClicked"
                    ToolTipProperties.Text="{DynamicResource s_ui_100}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
