<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Views.EmojiPickerView">
    <Border BackgroundColor="{DynamicResource SurfaceAlt}"
            StrokeThickness="0"
            Padding="8,8">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <ScrollView MaximumHeightRequest="220">
            <VerticalStackLayout x:Name="Container" Spacing="4" />
        </ScrollView>
    </Border>
</ContentView>
