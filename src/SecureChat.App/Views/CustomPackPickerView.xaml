<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecureChat.App.Views.CustomPackPickerView">
    <Border BackgroundColor="{DynamicResource SurfaceAlt}"
            StrokeThickness="0"
            Padding="8,8">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Label Text="{DynamicResource s_ui_194}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="＋ GIF"
                        FontSize="11"
                        Padding="8,2"
                        HeightRequest="26"
                        Style="{DynamicResource GhostButton}"
                        Clicked="OnImportGifClicked" />
                <Button Grid.Column="2"
                        Text="{DynamicResource s_ui_191}"
                        FontSize="11"
                        Padding="8,2"
                        HeightRequest="26"
                        Style="{DynamicResource GhostButton}"
                        Clicked="OnImportStickerClicked" />
            </Grid>

            <Label x:Name="EmptyLabel"
                   Text="{DynamicResource s_ui_147}"
                   FontSize="11"
                   TextColor="{DynamicResource TextMuted}"
                   IsVisible="False" />

            <ScrollView MaximumHeightRequest="200">
                <VerticalStackLayout x:Name="Container" Spacing="6" />
            </ScrollView>
        </VerticalStackLayout>
    </Border>
</ContentView>
