<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SecureChat.App.Views"
             x:Class="SecureChat.App.Views.ChatView">
    <ContentView.Resources>
        <ResourceDictionary>
            <views:EditedToLabelConverter x:Key="EditedToLabelConverter" />
            <views:DeliveryToDotsConverter x:Key="DeliveryToDotsConverter" />
            <views:PausePlayConverter x:Key="PausePlayConverter" />
            <views:PercentToDoubleConverter x:Key="PercentToDoubleConverter" />
            <views:InvertedBoolConverter x:Key="InvertedBool" />

            <DataTemplate x:Key="PendingMediaItemTemplate">
                <Grid ColumnDefinitions="36,Auto,*,32" ColumnSpacing="6" Padding="4">
                    <Label Grid.Column="0"
                           Text="{Binding KindEmoji}"
                           FontSize="18"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label Text="{Binding FileName}"
                               FontSize="12"
                               TextColor="{DynamicResource TextPrimary}"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <Label Text="{Binding Status}"
                               FontSize="11"
                               TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>
                    <ProgressBar Grid.Column="2"
                                 Progress="{Binding Progress, Converter={StaticResource PercentToDoubleConverter}}"
                                 HeightRequest="6"
                                 VerticalOptions="Center" />
                    <Button Grid.Column="3"
                            Text="✕"
                            Style="{DynamicResource IconButton}"
                            Clicked="OnCancelMediaClicked"
                            CommandParameter="{Binding Id}"
                            WidthRequest="32"
                            HeightRequest="32"
                            VerticalOptions="Center" />
                </Grid>
            </DataTemplate>

            <Style x:Key="BubbleActionButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="WidthRequest" Value="30" />
                <Setter Property="HeightRequest" Value="26" />
            </Style>
        </ResourceDictionary>
    
    

        

    </ContentView.Resources>

    <Grid x:Name="RootLayout" ColumnDefinitions="*,Auto">

        <!-- КОЛОНКА ПЕРЕПИСКИ -->
        <Grid Grid.Column="0"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
              BackgroundColor="{DynamicResource PageBackground}">

            <!-- Обои переписки (настройки → «Обои чата»); слои под всем контентом -->
            <Image Grid.Row="0"
                   Grid.RowSpan="8"
                   x:Name="WallpaperImage"
                   Aspect="AspectFill"
                   IsVisible="False"
                   InputTransparent="True" />
            <BoxView Grid.Row="0"
                     Grid.RowSpan="8"
                     x:Name="WallpaperShade"
                     Color="#000000"
                     Opacity="0.45"
                     IsVisible="False"
                     InputTransparent="True" />

            <!-- Шапка: собеседник и действия -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="6"
                  Padding="14,10"
                  BackgroundColor="{DynamicResource Surface}">

                <Border Grid.Column="0"
                        WidthRequest="42"
                        HeightRequest="42"
                        BackgroundColor="{DynamicResource Accent}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Image x:Name="ContactAvatar"
                           WidthRequest="42"
                           HeightRequest="42"
                           Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     Margin="4,0,0,0"
                                     VerticalOptions="Center">
                    <Label x:Name="ContactLabel"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="ContactStatusLabel"
                           FontSize="12"
                           TextColor="{DynamicResource TextMuted}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="🔍"
                        Style="{DynamicResource IconButton}"
                        Clicked="OnSearchInChatClicked"
                        ToolTipProperties.Text="{DynamicResource s_ui_119}" />
                <Button Grid.Column="3"
                        x:Name="ChatMenuButton"
                        Text="⋮"
                        Style="{DynamicResource IconButton}"
                        Clicked="OnChatMenuClicked"
                        ToolTipProperties.Text="{DynamicResource s_ui_065}" />
                <Button Grid.Column="4"
                        x:Name="CloseChatButton"
                        Text="✕"
                        Style="{DynamicResource IconButton}"
                        Clicked="OnCloseClicked"
                        ToolTipProperties.Text="{DynamicResource s_ui_044}" />
            </Grid>

            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource BorderColor}" />

            <!-- Поиск по переписке -->
            <SearchBar Grid.Row="2"
                       x:Name="MessageSearchBar"
                       Placeholder="{DynamicResource s_ui_116}"
                       IsVisible="False"
                       Margin="10,6"
                       TextChanged="OnMessageSearchChanged" />

            <!-- Предупреждение о ключе и офлайн-режим -->
            <VerticalStackLayout Grid.Row="3"
                                 Spacing="6"
                                 Padding="12,6,12,0">
                <Label x:Name="KeyWarningLabel"
                       FontSize="12"
                       TextColor="{DynamicResource Danger}"
                       Text="{DynamicResource s_ui_187}"
                       IsVisible="False"
                       LineBreakMode="WordWrap">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnKeyWarningTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Border x:Name="OfflineBanner"
                        IsVisible="False"
                        BackgroundColor="{DynamicResource SurfaceAlt}"
                        Stroke="{DynamicResource Warning}"
                        StrokeThickness="1"
                        Padding="10,5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label FontSize="11"
                           TextColor="{DynamicResource Warning}"
                           Text="{DynamicResource s_ui_188}"
                           LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>

            <!-- ЗАКРЕПЛЁННЫЕ СООБЩЕНИЯ: один компактный виджет -->
            <Border Grid.Row="1"
                    x:Name="PinnedSectionInline"
                    IsVisible="False"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    StrokeThickness="0"
                    Margin="12,6,12,4"
                    Padding="0,6,6,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPinnedBannerTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8">
                    <BoxView Grid.Column="0"
                             WidthRequest="3"
                             CornerRadius="2"
                             BackgroundColor="{DynamicResource Accent}"
                             VerticalOptions="Fill" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="1"
                                         VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{DynamicResource s_ui_040}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Accent}"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="{DynamicResource Surface}"
                                    StrokeThickness="0"
                                    Padding="5,0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label x:Name="PinnedCountLabelInline"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Accent}"
                                       VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label x:Name="PinnedLabelInline"
                               FontSize="12"
                               TextColor="{DynamicResource TextPrimary}"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="2"
                                           Spacing="2"
                                           VerticalOptions="Center">
                        <Button Text="↑"
                                FontSize="13"
                                WidthRequest="26"
                                HeightRequest="26"
                                Padding="0"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Accent}"
                                CornerRadius="6"
                                Clicked="OnPinnedUpClicked"
                                ToolTipProperties.Text="{DynamicResource s_ui_132}" />
                        <Button Text="↓"
                                FontSize="13"
                                WidthRequest="26"
                                HeightRequest="26"
                                Padding="0"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Accent}"
                                CornerRadius="6"
                                Clicked="OnPinnedDownClicked"
                                ToolTipProperties.Text="{DynamicResource s_ui_149}" />
                        <Button Text="✕"
                                FontSize="13"
                                WidthRequest="26"
                                HeightRequest="26"
                                Padding="0"
                                MinimumWidthRequest="0"
                                MinimumHeightRequest="0"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource TextMuted}"
                                CornerRadius="6"
                                Clicked="OnUnpinBannerClicked"
                                ToolTipProperties.Text="{DynamicResource s_ui_096}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Сообщения -->
            <CollectionView Grid.Row="4"
                            x:Name="MessagesView"
                            SelectionMode="None"
                            ItemsLayout="VerticalList"
                            BackgroundColor="Transparent">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,32" Spacing="8" VerticalOptions="Center">
                        <Label Text="✉️"
                               Style="{DynamicResource EmptyStateIcon}" />
                        <Label Text="{DynamicResource s_ui_085}"
                               Style="{DynamicResource EmptyStateTitle}" />
                        <Label Text="{DynamicResource s_ui_076}"
                               Style="{DynamicResource EmptyStateCaption}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="views:MessageVm">
                        <VerticalStackLayout IsVisible="{Binding MatchesSearch}"
                                             Spacing="0">

                            <!-- Разделитель дат -->
                            <Border IsVisible="{Binding HasDateLabel}"
                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                    StrokeThickness="0"
                                    Padding="12,3"
                                    Margin="0,10,0,6"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding DateLabel}"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}" />
                            </Border>

                            <Grid ColumnDefinitions="36,*"
                                  ColumnSpacing="6"
                                  Padding="14,2"
                                  IsVisible="{Binding IsAlbumTail, Converter={StaticResource InvertedBool}}">

                                <!-- Аватар собеседника (у первого сообщения в серии) -->
                                <Grid Grid.Column="0"
                                      WidthRequest="30"
                                      HeightRequest="30"
                                      VerticalOptions="End"
                                      IsVisible="{Binding ShowAvatar}">
                                    <!-- Цветной круг с буквой (fallback) -->
                                    <Border BackgroundColor="{Binding SenderAvatarColor}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding SenderInitial}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <!-- Реальный фото-аватар (если загружен) -->
                                    <Image Source="{Binding SenderAvatarImageSource}"
                                           Aspect="AspectFill"
                                           WidthRequest="30"
                                           HeightRequest="30">
                                        <Image.Clip>
                                            <EllipseGeometry />
                                        </Image.Clip>
                                    </Image>
                                </Grid>

                                <!-- Пузырь сообщения -->
                                <Border x:Name="BubbleBorder"
                                        Grid.Column="1"
                                        Style="{Binding BubbleStyle}"
                                        VerticalOptions="Start">

                                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasPoll, Converter={StaticResource InvertedBool}}">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBubbleTapped" />
                                        <PointerGestureRecognizer PointerPressed="OnBubblePointerPressed"
                                                                  PointerReleased="OnBubblePointerReleased"
                                                                  PointerExited="OnBubblePointerExited" />
                                    </VerticalStackLayout.GestureRecognizers>

                                        <!-- Цитата ответа -->
                                        <Border IsVisible="{Binding HasReplyQuote}"
                                                BackgroundColor="{DynamicResource SurfaceAlt}"
                                                StrokeThickness="0"
                                                Padding="8"
                                                Margin="0,0,0,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding ReplyQuoteAuthorText}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource Accent}" />
                                                <Label Text="{Binding ReplyQuoteText}"
                                                       FontSize="12"
                                                       FontAttributes="Italic"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Label IsVisible="{Binding IsForwarded}"
                                               Text="{Binding ForwardedText}"
                                               FontSize="11"
                                               FontAttributes="Italic"
                                               TextColor="{DynamicResource TextMuted}" />

                                        <!-- Одноразовое сообщение -->
                                        <Label IsVisible="{Binding IsOnce}"
                                               Text="{DynamicResource s_ui_195}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource Warning}" />

                                        <!-- Текст сообщения (или с подсветкой @упоминаний) -->

                                        <Label Text="{Binding DisplayText}"
                                               Style="{Binding TextStyle}"
                                               LineBreakMode="WordWrap"
                                               IsVisible="{Binding ShowPlainText}" />
                                        <Label FormattedText="{Binding TextFormatted}"
                                               Style="{Binding TextStyle}"
                                               LineBreakMode="WordWrap"
                                               IsVisible="{Binding ShowRichText}" />

                                        <!-- Стикер: крупный глиф без стилей текста, как большие эмодзи в Telegram -->
                                        <Label Text="{Binding DisplayText}"
                                               FontSize="46"
                                               TextColor="{DynamicResource TextPrimary}"
                                               IsVisible="{Binding IsSticker}"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center" />

                                        <!-- Скрытые цели markdown-ссылок: три фиксированных чипа -->
                                        <VerticalStackLayout IsVisible="{Binding HasHiddenChips}"
                                                             Spacing="4"
                                                             Margin="0,6,0,0"
                                                             HorizontalOptions="Start">
                                            <Label Text="{Binding Chip0Text}"
                                                   IsVisible="{Binding ShowChip0}"
                                                   TextColor="{DynamicResource Accent}"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HorizontalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnChip0Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Text="{Binding Chip1Text}"
                                                   IsVisible="{Binding ShowChip1}"
                                                   TextColor="{DynamicResource Accent}"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HorizontalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnChip1Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Text="{Binding Chip2Text}"
                                                   IsVisible="{Binding ShowChip2}"
                                                   TextColor="{DynamicResource Accent}"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HorizontalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnChip2Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Превью ссылок (Open Graph): три фиксированные карточки.
                             Фиксированные слоты, а не BindableLayout: шаблон внутри пузыря
                             в этой версии MAUI не получал контекст элемента. -->
                                        <VerticalStackLayout IsVisible="{Binding HasLinkPreviews}"
                                                             Spacing="6"
                                                             Margin="0,6,0,0"
                                                             HorizontalOptions="Start">
                                            <Border IsVisible="{Binding ShowPreview0}"
                                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                                    StrokeThickness="0"
                                                    Padding="8"
                                                    MaximumWidthRequest="260"
                                                    HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPreview0Tapped" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="4">
                                                    <Image Source="{Binding Preview0Image}"
                                                           IsVisible="{Binding Preview0HasImage}"
                                                           Aspect="AspectFill"
                                                           WidthRequest="244"
                                                           HeightRequest="110"
                                                           HorizontalOptions="Fill" />
                                                    <Label Text="{Binding Preview0Title}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding Preview0Description}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding Preview0Domain}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border IsVisible="{Binding ShowPreview1}"
                                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                                    StrokeThickness="0"
                                                    Padding="8"
                                                    MaximumWidthRequest="260"
                                                    HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPreview1Tapped" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="4">
                                                    <Image Source="{Binding Preview1Image}"
                                                           IsVisible="{Binding Preview1HasImage}"
                                                           Aspect="AspectFill"
                                                           WidthRequest="244"
                                                           HeightRequest="110"
                                                           HorizontalOptions="Fill" />
                                                    <Label Text="{Binding Preview1Title}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding Preview1Description}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding Preview1Domain}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border IsVisible="{Binding ShowPreview2}"
                                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                                    StrokeThickness="0"
                                                    Padding="8"
                                                    MaximumWidthRequest="260"
                                                    HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPreview2Tapped" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="4">
                                                    <Image Source="{Binding Preview2Image}"
                                                           IsVisible="{Binding Preview2HasImage}"
                                                           Aspect="AspectFill"
                                                           WidthRequest="244"
                                                           HeightRequest="110"
                                                           HorizontalOptions="Fill" />
                                                    <Label Text="{Binding Preview2Title}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding Preview2Description}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding Preview2Domain}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- Альбом: несколько фото сеткой 2×2, как в Telegram -->
                                        <Grid IsVisible="{Binding IsAlbumHead}"
                                              ColumnDefinitions="Auto,Auto"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="2"
                                              RowSpacing="2"
                                              Margin="0,2">
                                            <Border Grid.Row="0"
                                                    Grid.Column="0"
                                                    IsVisible="{Binding HasAlbumImage0}"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding AlbumImage0}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="150"
                                                       HeightRequest="150" />
                                            </Border>
                                            <Border Grid.Row="0"
                                                    Grid.Column="1"
                                                    IsVisible="{Binding HasAlbumImage1}"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding AlbumImage1}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="150"
                                                       HeightRequest="150" />
                                            </Border>
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    IsVisible="{Binding HasAlbumImage2}"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding AlbumImage2}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="150"
                                                       HeightRequest="150" />
                                            </Border>
                                            <Border Grid.Row="1"
                                                    Grid.Column="1"
                                                    IsVisible="{Binding HasAlbumImage3}"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding AlbumImage3}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="150"
                                                       HeightRequest="150" />
                                            </Border>
                                            <Label Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding AlbumCountLabel}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   HorizontalTextAlignment="Center"
                                                   IsVisible="{Binding IsAlbumHead}" />
                                        </Grid>

                                        <!-- Изображение -->
                                        <Grid IsVisible="{Binding ShowSingleImage}"
                                              RowDefinitions="Auto,Auto"
                                              RowSpacing="4">
                                            <Border IsVisible="{Binding IsImagePending}"
                                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                                    StrokeThickness="0"
                                                    Padding="20,14">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{DynamicResource s_ui_038}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding ShowMediaDownloadText}" />
                                                    <Grid IsVisible="{Binding IsMediaDownloading}"
                                                          ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                            <ProgressBar Progress="{Binding MediaProgress}"
                                                                         ProgressColor="{DynamicResource Accent}"
                                                                         BackgroundColor="{DynamicResource BorderColor}"
                                                                         HeightRequest="4" />
                                                            <Label Text="{Binding MediaProgressText}"
                                                                   FontSize="11"
                                                                   TextColor="{DynamicResource TextMuted}" />
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="1"
                                                                Text="✕"
                                                                Style="{DynamicResource IconButton}"
                                                                Clicked="OnCancelMediaDownloadClicked"
                                                                CommandParameter="{Binding Id}"
                                                                WidthRequest="30"
                                                                HeightRequest="30"
                                                                VerticalOptions="Center" />
                                                    </Grid>
                                                </VerticalStackLayout>

                                            </Border>
                                            <Grid IsVisible="{Binding IsImageReady}">
                                                <views:GifWebView IsVisible="{Binding IsAnimatedGif}"
                                                                  Bytes="{Binding GifBytes}"
                                                                  SurfaceHex="{Binding GifSurfaceHex}" />
                                                <Image Source="{Binding ImageSource}"
                                                       IsVisible="{Binding IsStaticImage}"
                                                       Aspect="AspectFit"
                                                       MaximumWidthRequest="340"
                                                       MaximumHeightRequest="240"
                                                       HorizontalOptions="Start" />
                                            </Grid>
                                            <Button Grid.Row="1"
                                                    Text="{DynamicResource s_ui_129}"
                                                    IsVisible="{Binding IsImageReady}"
                                                    Style="{DynamicResource GhostButton}"
                                                    FontSize="12"
                                                    Padding="8,2"
                                                    HeightRequest="28"
                                                    HorizontalOptions="Start"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnOpenImageClicked" />
                                        </Grid>

                                        <!-- Встроенное видео-файл: крупный плеер как в Telegram -->
                                        <Grid IsVisible="{Binding IsVideoFile}"
                                              Margin="0,2">
                                            <views:GifWebView IsVisible="{Binding IsVideoReady}"
                                                              MediaKind="Video"
                                                              Bytes="{Binding VideoBytes}"
                                                              MediaContentType="{Binding ContentType}"
                                                              SurfaceHex="#000000" />
                                            <Grid IsVisible="{Binding IsVideoPending}"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                    <Label Text="{DynamicResource s_ui_037}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding ShowMediaDownloadText}" />
                                                    <ProgressBar Progress="{Binding MediaProgress}"
                                                                 ProgressColor="{DynamicResource Accent}"
                                                                 BackgroundColor="{DynamicResource BorderColor}"
                                                                 HeightRequest="4"
                                                                 IsVisible="{Binding IsMediaDownloading}" />
                                                    <Label Text="{Binding MediaProgressText}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding IsMediaDownloading}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1"
                                                        Text="✕"
                                                        Style="{DynamicResource IconButton}"
                                                        Clicked="OnCancelMediaDownloadClicked"
                                                        CommandParameter="{Binding Id}"
                                                        WidthRequest="30"
                                                        HeightRequest="30"
                                                        VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>

                                        <!-- Файл -->
                                        <Border IsVisible="{Binding IsFile}"
                                                BackgroundColor="{DynamicResource SurfaceAlt}"
                                                StrokeThickness="0"
                                                Padding="10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Label Grid.Column="0"
                                                       Text="📄"
                                                       FontSize="20"
                                                       VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="2"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding FileName}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           LineBreakMode="MiddleTruncation" />
                                                    <Label Text="{Binding FileSizeText}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}" />
                                                    <Label Text="Загрузка…"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding IsFilePending}" />
                                                    <ProgressBar Progress="{Binding MediaProgress}"
                                                                 ProgressColor="{DynamicResource Accent}"
                                                                 BackgroundColor="{DynamicResource BorderColor}"
                                                                 HeightRequest="4"
                                                                 IsVisible="{Binding IsMediaDownloading}" />
                                                    <Label Text="{Binding MediaProgressText}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding IsMediaDownloading}" />
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="2"
                                                                     Spacing="4"
                                                                     VerticalOptions="Center">
                                                    <Button Text="✕"
                                                            IsVisible="{Binding IsMediaDownloading}"
                                                            Style="{DynamicResource IconButton}"
                                                            Clicked="OnCancelMediaDownloadClicked"
                                                            CommandParameter="{Binding Id}"
                                                            WidthRequest="30"
                                                            HeightRequest="30" />
                                                    <Button Text="{Binding ActionButtonText}"
                                                            IsVisible="{Binding CanOpenFile}"
                                                            Style="{DynamicResource GhostButton}"
                                                            FontSize="12"
                                                            Padding="8,2"
                                                            HeightRequest="28"
                                                            VerticalOptions="Center"
                                                            CommandParameter="{Binding .}"
                                                            Clicked="OnMediaActionClicked" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>

                                        <!-- Голосовое сообщение (инлайн-плеер) -->
                                        <Border IsVisible="{Binding IsVoice}"
                                                BackgroundColor="{DynamicResource SurfaceAlt}"
                                                StrokeThickness="0"
                                                Padding="10,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Label Grid.Column="0"
                                                        Text="🎙️"
                                                        FontSize="16"
                                                        VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1"
                                                                   Spacing="0"
                                                                   VerticalOptions="Center">
                                                    <Border HeightRequest="24"
                                                            Padding="0,10"
                                                            BackgroundColor="Transparent"
                                                            StrokeThickness="0">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnVoiceProgressTapped" />
                                                        </Border.GestureRecognizers>
                                                        <ProgressBar Progress="{Binding PlaybackProgress, Converter={StaticResource PercentToDoubleConverter}}"
                                                                     HeightRequest="4"
                                                                     VerticalOptions="Center"
                                                                     ProgressColor="{DynamicResource Accent}"
                                                                     BackgroundColor="{DynamicResource BorderColor}" />
                                                    </Border>
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="6"
                                                          Margin="0,-2,0,0">
                                                        <Label Text="{Binding PlaybackTimeText}"
                                                               FontSize="11"
                                                               TextColor="{DynamicResource TextMuted}"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding PlaybackDurationText}"
                                                               FontSize="11"
                                                               TextColor="{DynamicResource TextMuted}"
                                                               HorizontalTextAlignment="End"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                                <Button Grid.Column="2"
                                                        x:Name="PlayVoiceButton"
                                                        Text="{Binding IsPlaying, Converter={StaticResource PausePlayConverter}}"
                                                        FontSize="14"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Padding="0"
                                                        MinimumWidthRequest="0"
                                                        MinimumHeightRequest="0"
                                                        BackgroundColor="{DynamicResource Accent}"
                                                        TextColor="White"
                                                        CornerRadius="16"
                                                        VerticalOptions="Center"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnPlayVoiceClicked" />
                                            </Grid>
                                        </Border>

                                        <!-- Видеокружок: встроенное видео, как в Telegram -->
                                        <Grid IsVisible="{Binding IsVideoCircle}"
                                              HorizontalOptions="Start"
                                              Margin="0,2">
                                            <views:GifWebView IsVisible="{Binding IsVideoReady}"
                                                              MediaKind="VideoCircle"
                                                              Bytes="{Binding VideoBytes}"
                                                              MediaContentType="{Binding ContentType}"
                                                              SurfaceHex="#000000" />
                                            <!-- Бейдж длительности поверх видео -->
                                            <Label IsVisible="{Binding HasVideoDuration}"
                                                   Text="{Binding VideoDurationText}"
                                                   FontSize="12"
                                                   BackgroundColor="#CC000000"
                                                   TextColor="White"
                                                   Padding="7,2"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Start"
                                                   Margin="6,6,0,0" />
                                            <!-- Пока видео грузится — карточка ожидания -->
                                            <Border IsVisible="{Binding IsVideoPending}"
                                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                                    StrokeThickness="0"
                                                    Padding="10,8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <Label Text="📹" FontSize="16" VerticalOptions="Center" />
                                                    <Label Text="{DynamicResource s_ui_037}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <!-- Большое видео: инлайн-плеер небезопасен по памяти — карточка с ▶ -->
                                            <Border IsVisible="{Binding ShowVideoFallback}"
                                                    BackgroundColor="{DynamicResource SurfaceAlt}"
                                                    StrokeThickness="0"
                                                    Padding="10,8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Label Text="📹" FontSize="16" VerticalOptions="Center" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding FileSizeText, StringFormat='Video note · {0}'}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           VerticalOptions="Center" />
                                                    <Button Grid.Column="2"
                                                            Text="▶"
                                                            FontSize="14"
                                                            WidthRequest="32"
                                                            HeightRequest="32"
                                                            Padding="0"
                                                            BackgroundColor="{DynamicResource Accent}"
                                                            TextColor="White"
                                                            CornerRadius="16"
                                                            VerticalOptions="Center"
                                                            CommandParameter="{Binding .}"
                                                            Clicked="OnPlayVideoCircleClicked" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Реакции: каждый эмодзи — отдельный чип со счётчиком -->
                                        <CollectionView IsVisible="{Binding HasReactions}"
                                                        ItemsSource="{Binding ReactionChips}"
                                                        HeightRequest="26"
                                                        SelectionMode="None"
                                                        HorizontalOptions="Start">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="4" />
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="views:ReactionChipVm">
                                                    <Border Padding="6,1"
                                                            BackgroundColor="{DynamicResource SurfaceAlt}"
                                                            StrokeThickness="0"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <HorizontalStackLayout Spacing="3">
                                                            <Label Text="{Binding Emoji}"
                                                                   FontSize="12"
                                                                   VerticalOptions="Center" />
                                                            <Label Text="{Binding CountText}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{DynamicResource Accent}"
                                                                   VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <!-- Панель действий: видна у выделенного сообщения -->
                                        <HorizontalStackLayout IsVisible="{Binding IsSelected}"
                                                               Spacing="2"
                                                               Margin="0,4,0,0"
                                                               HorizontalOptions="End">
                                            <Button Style="{StaticResource BubbleActionButton}"
                                                    Text="📋"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnActionCopyClicked"
                                                    ToolTipProperties.Text="{DynamicResource s_ui_060}" />
                                            <Button Style="{StaticResource BubbleActionButton}"
                                                    Text="↩️"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnActionReplyClicked"
                                                    ToolTipProperties.Text="{DynamicResource s_ui_095}" />
                                            <Button Style="{StaticResource BubbleActionButton}"
                                                    Text="😊"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnActionReactionClicked"
                                                    ToolTipProperties.Text="{DynamicResource s_ui_140}" />
                                            <Button Style="{StaticResource BubbleActionButton}"
                                                    Text="↪️"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnActionForwardClicked"
                                                    ToolTipProperties.Text="{DynamicResource s_ui_113}" />
                                            <Button Style="{StaticResource BubbleActionButton}"
                                                    Text="📌"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnActionPinClicked"
                                                    ToolTipProperties.Text="{DynamicResource s_ui_039}" />
                                            <Button Style="{StaticResource BubbleActionButton}"
                                                    Text="✏️"
                                                    IsVisible="{Binding IsMine}"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnActionEditClicked"
                                                    ToolTipProperties.Text="{DynamicResource s_ui_141}" />
                                            <Button Style="{StaticResource BubbleActionButton}"
                                                    Text="🗑️"
                                                    TextColor="{DynamicResource Danger}"
                                                    IsVisible="{Binding IsMine}"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnActionDeleteClicked"
                                                    ToolTipProperties.Text="Удалить" />
                                        </HorizontalStackLayout>

                                        <!-- Мета: закреплено, черновик, изменено, время, статус доставки -->
                                        <HorizontalStackLayout Spacing="5"
                                                               Margin="0,2,0,0"
                                                               HorizontalOptions="End">
                                            <Label Text="📌"
                                                   FontSize="10"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsPinned}" />
                                            <Label Text="{DynamicResource s_ui_201}"
                                                   FontSize="11"
                                                   FontAttributes="Italic"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsDraft}" />
                                            <Label Text="{Binding EditedText, Converter={StaticResource EditedToLabelConverter}}"
                                                   Style="{StaticResource EditedLabel}"
                                                   FontAttributes="Italic"
                                                   TextColor="{Binding MetaColor}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsEdited}" />
                                            <Label Text="{Binding TimeText}"
                                                   FontSize="11"
                                                   TextColor="{Binding MetaColor}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{DynamicResource ShowTimestamps}" />
                                            <Label Text="{Binding DeliveryStatus, Converter={StaticResource DeliveryToDotsConverter}}"
                                                   Style="{StaticResource DeliveryDots}"
                                                   TextColor="{Binding DeliveryColor}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsMine}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                        <!-- Опрос: отдельная область без жестов пузыря, чтобы кнопки работали -->
                                        <VerticalStackLayout Spacing="6" IsVisible="{Binding HasPoll}"
                                                             Padding="10">
                                            <views:PollView Poll="{Binding Poll}" />
                                        </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Подсказка и черновик -->
            <VerticalStackLayout Grid.Row="5"
                                 Padding="16,0,16,4">
                <Label x:Name="HintLabel"
                       FontSize="12"
                       TextColor="{DynamicResource TextMuted}"
                       IsVisible="False"
                       LineBreakMode="WordWrap" />
                <Label x:Name="DraftLabel"
                       FontSize="12"
                       FontAttributes="Italic"
                       TextColor="{DynamicResource Warning}"
                       Text="{DynamicResource s_ui_200}"
                       IsVisible="False" />
            </VerticalStackLayout>



            


            <!-- Меню скрепки, как в Telegram (выезжает вверх над кнопкой 📎) -->
            <Border Grid.Row="6"
                    x:Name="AttachMenuPanel"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="14,-290,0,0"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    IsVisible="False"
                    Padding="0,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <!-- Фото или видео -->
                    <Border StyleId="photo"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            Padding="16,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttachMenuItemTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🖼" FontSize="15" VerticalOptions="Center" />
                            <Label Text="{DynamicResource s_ui_170}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Файл -->
                    <Border StyleId="file"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            Padding="16,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttachMenuItemTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="📄" FontSize="15" VerticalOptions="Center" />
                            <Label Text="{DynamicResource s_ui_169}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Музыка -->
                    <Border StyleId="music"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            Padding="16,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttachMenuItemTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🎵" FontSize="15" VerticalOptions="Center" />
                            <Label Text="{DynamicResource s_ui_068}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Голосовое сообщение -->
                    <Border StyleId="voice"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            Padding="16,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttachMenuItemTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🎤" FontSize="15" VerticalOptions="Center" />
                            <Label Text="{DynamicResource s_ui_022}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Видеокружок -->
                    <Border StyleId="circle"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            Padding="16,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttachMenuItemTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="📹" FontSize="15" VerticalOptions="Center" />
                            <Label Text="{DynamicResource s_ui_012}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Поле ввода -->
            <Border Grid.Row="7"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0"
                    Padding="12,10">
                <VerticalStackLayout Spacing="8">
                    <!-- Очередь отправки вложений: прогресс и отмена (как в Telegram) -->
                    <Border x:Name="SendQueuePanel"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            StrokeThickness="0"
                            Padding="8,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingMedia}"
                                             Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="36,Auto,*,32" ColumnSpacing="6" Padding="4">
                                        <Label Grid.Column="0"
                                               Text="{Binding KindEmoji}"
                                               FontSize="18"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label Text="{Binding FileName}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Text="{Binding Status}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                        <ProgressBar Grid.Column="2"
                                                     Progress="{Binding Progress, Converter={StaticResource PercentToDoubleConverter}}"
                                                     HeightRequest="6"
                                                     VerticalOptions="Center" />
                                        <Button Grid.Column="3"
                                                Text="✕"
                                                Style="{DynamicResource IconButton}"
                                                Clicked="OnCancelMediaClicked"
                                                CommandParameter="{Binding Id}"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Панель в стиле Telegram: вкладки Эмодзи | Стикеры | GIF -->
                    <Border x:Name="MediaPanel"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            Padding="6,4,6,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="2" HorizontalOptions="Start">
                                <Button x:Name="EmojiTabButton"
                                        Grid.Column="0"
                                        Text="{DynamicResource s_ui_202}"
                                        Clicked="OnPanelTabClicked"
                                        CommandParameter="Emoji"
                                        Style="{DynamicResource GhostButton}"
                                        FontSize="13"
                                        Padding="10,4" />
                                <Button x:Name="StickerTabButton"
                                        Grid.Column="1"
                                        Text="{DynamicResource s_ui_204}"
                                        Clicked="OnPanelTabClicked"
                                        CommandParameter="Stickers"
                                        Style="{DynamicResource GhostButton}"
                                        FontSize="13"
                                        Padding="10,4" />
                                <Button x:Name="GifTabButton"
                                        Grid.Column="2"
                                        Text="🎬 GIF"
                                        Clicked="OnPanelTabClicked"
                                        CommandParameter="Gifs"
                                        Style="{DynamicResource GhostButton}"
                                        FontSize="13"
                                        Padding="10,4" />
                                <Button x:Name="PacksTabButton"
                                        Grid.Column="3"
                                        Text="{DynamicResource s_ui_193}"
                                        Clicked="OnPanelTabClicked"
                                        CommandParameter="Packs"
                                        Style="{DynamicResource GhostButton}"
                                        FontSize="13"
                                        Padding="10,4" />
                            </Grid>
                            <views:EmojiPickerView x:Name="EmojiTabContent"
                                                   EmojiPicked="OnEmojiPicked" />
                            <views:StickerPickerView x:Name="StickerTabContent"
                                                     IsVisible="False"
                                                     StickerPicked="OnStickerPicked" />
                            <views:GifPickerView x:Name="GifTabContent"
                                                 IsVisible="False"
                                                 GifPicked="OnGifPicked" />
                            <views:CustomPackPickerView x:Name="PacksTabContent"
                                                       IsVisible="False"
                                                       ImportRequested="OnCustomPackImportRequested"
                                                       ItemPicked="OnCustomPackItemPicked" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Панель ответа на сообщение -->
                    <Border x:Name="ReplyBar"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            StrokeThickness="0"
                            Padding="10,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label x:Name="ReplyPreviewLabel"
                                   Text="{DynamicResource s_ui_183}"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimary}"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Button x:Name="CancelReplyButton"
                                    Text="✕"
                                    Style="{DynamicResource IconButton}"
                                    Clicked="OnCancelReplyClicked"
                                    ToolTipProperties.Text="{DynamicResource s_ui_105}"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Панель редактирования сообщения -->
                    <Border x:Name="EditBar"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource SurfaceAlt}"
                            StrokeThickness="0"
                            Padding="10,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label x:Name="EditPreviewLabel"
                                   Text="{DynamicResource s_ui_190}"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Button x:Name="CancelEditButton"
                                    Text="✕"
                                    Style="{DynamicResource IconButton}"
                                    Clicked="OnCancelEditClicked"
                                    ToolTipProperties.Text="{DynamicResource s_ui_106}"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <HorizontalStackLayout Grid.Column="0"
                                               Spacing="8"
                                               VerticalOptions="End">
                            <Button x:Name="AttachButton"
                                    Text="📎"
                                    Style="{DynamicResource IconButton}"
                                    VerticalOptions="End"
                                    Clicked="OnAttachClicked"
                                    ToolTipProperties.Text="{DynamicResource s_ui_133}" />
                            <Button x:Name="PollButton"
                                    Text="📊"
                                    Style="{DynamicResource IconButton}"
                                    VerticalOptions="End"
                                    Clicked="OnCreatePollClicked"
                                    ToolTipProperties.Text="Опрос" />
                            <Button x:Name="EmojiButton"
                                    Text="😊"
                                    Style="{DynamicResource IconButton}"
                                    VerticalOptions="End"
                                    Clicked="OnEmojiButtonClicked"
                                    ToolTipProperties.Text="{DynamicResource s_ui_175}" />
                            <Button x:Name="ViewOnceButton"
                                    Text="👁"
                                    Style="{DynamicResource IconButton}"
                                    VerticalOptions="End"
                                    Clicked="OnViewOnceToggled"
                                    ToolTipProperties.Text="{DynamicResource s_ui_093}" />
                        </HorizontalStackLayout>

                        <views:MentionEntryView Grid.Column="1"
                                                x:Name="MessageEntry"
                                                VerticalOptions="Center"
                                                Placeholder="{DynamicResource s_ui_077}"
                                                Completed="OnSendClicked"
                                                TextChanged="OnMessageTextChanged" />

                        <Button x:Name="SendButton"
                                Grid.Column="2"
                                Text="➤"
                                Style="{DynamicResource PrimaryButton}"
                                Clicked="OnSendClicked"
                                WidthRequest="44"
                                HeightRequest="44"
                                CornerRadius="22"
                                Padding="0"
                                VerticalOptions="End"
                                ToolTipProperties.Text="{DynamicResource s_ui_108}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>


        </Grid>

        <!-- ПРАВАЯ ПАНЕЛЬ: ПРОФИЛЬ / МЕДИА / ЗАКРЕПЛЁННЫЕ -->
        <Border Grid.Column="0"
                Grid.ColumnSpan="2"
                x:Name="InfoPanel"
                HorizontalOptions="End"
                WidthRequest="320"
                IsVisible="False"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Padding="14,10"
                      BackgroundColor="{DynamicResource SurfaceAlt}">
                    <Label x:Name="InfoPanelTitle"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="✕"
                            Style="{DynamicResource IconButton}"
                            Clicked="OnCloseInfoPanelClicked"
                            ToolTipProperties.Text="{DynamicResource s_ui_043}" />
                </Grid>

                <!-- ПРОФИЛЬ СОБЕСЕДНИКА -->
                <ScrollView Grid.Row="1"
                            x:Name="ProfileSection"
                            IsVisible="False">
                    <VerticalStackLayout Padding="16"
                                         Spacing="14">
                        <Border WidthRequest="84"
                                HeightRequest="84"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Image x:Name="ProfileAvatar"
                                   WidthRequest="84"
                                   HeightRequest="84"
                                   Aspect="AspectFill" />
                        </Border>

                        <Label x:Name="ProfileName"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               HorizontalTextAlignment="Center" />

                        <Label x:Name="ProfileStatus"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalTextAlignment="Center" />

                        <Label x:Name="ProfileBio"
                               FontSize="13"
                               TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap" />

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{DynamicResource BorderColor}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Отпечаток ключа"
                                   Style="{DynamicResource SectionTitle}"
                                   Margin="0" />
                            <Label x:Name="ProfileFingerprint"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   TextColor="{DynamicResource TextSecondary}"
                                   LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{DynamicResource s_ui_049}"
                                   Style="{DynamicResource SectionTitle}"
                                   Margin="0" />
                            <Label x:Name="ProfileUserId"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   TextColor="{DynamicResource TextMuted}"
                                   LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{DynamicResource s_ui_004}"
                                   Style="{DynamicResource SectionTitle}"
                                   Margin="0" />
                            <Label x:Name="ProfileCreated"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- МЕДИА И ФАЙЛЫ -->
                <Grid Grid.Row="1"
                      x:Name="MediaSection"
                      IsVisible="False"
                      RowDefinitions="Auto,*,Auto">
                    <Label Grid.Row="0"
                           Text="{DynamicResource s_ui_063}"
                           Style="{DynamicResource SectionTitle}"
                           Margin="16,12,16,6" />
                    <CollectionView Grid.Row="1"
                                    x:Name="MediaItemsView"
                                    SelectionMode="None"
                                    BackgroundColor="Transparent">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="views:MediaListItemVm">
                                <VerticalStackLayout Spacing="0">

                                    <!-- Заголовок группы по дате -->
                                    <Border IsVisible="{Binding IsHeader}"
                                            BackgroundColor="Transparent"
                                            Padding="12,12,12,4">
                                        <Label Text="{Binding Title}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextMuted}" />
                                    </Border>

                                    <!-- Само вложение -->
                                    <Grid IsVisible="{Binding IsItem}"
                                          Padding="12,4"
                                          ColumnDefinitions="44,*"
                                          ColumnSpacing="10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMediaItemTapped" />
                                        </Grid.GestureRecognizers>
                                        <Border Grid.Column="0"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                BackgroundColor="{DynamicResource SurfaceAlt}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Grid>
                                                <Image Source="{Binding Message.ImageSource}"
                                                       Aspect="AspectFill"
                                                       IsVisible="{Binding Message.IsImageReady}" />
                                                <Label Text="{Binding Message.MediaIcon}"
                                                       FontSize="20"
                                                       VerticalTextAlignment="Center"
                                                       HorizontalTextAlignment="Center"
                                                       IsVisible="{Binding Message.ShowMediaIcon}" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Message.FileName}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Message.MediaTypeText}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}" />
                                                <Label Text="{Binding Message.FileSizeText}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}" />
                                                <Label Text="{Binding Message.VideoDurationText}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       IsVisible="{Binding Message.HasVideoDuration}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Grid.Row="2"
                           x:Name="MediaEmptyLabel"
                           Text="{DynamicResource s_ui_082}"
                           FontSize="12"
                           TextColor="{DynamicResource TextMuted}"
                           Margin="16"
                           IsVisible="False" />
                </Grid>

                <!-- ЗАКРЕПЛЁННЫЕ СООБЩЕНИЯ -->
                <Grid Grid.Row="1"
                      x:Name="PinnedSection"
                      IsVisible="False"
                      RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Label Grid.Row="0"
                           Text="{DynamicResource s_ui_042}"
                           Style="{DynamicResource SectionTitle}"
                           Margin="16,12,16,6" />
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto,Auto,*"
                          ColumnSpacing="4"
                          Margin="16,0,16,6">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource Accent}"
                                StrokeThickness="1"
                                Padding="6,2"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="3">
                                <Label Text="📌"
                                       FontSize="9"
                                       VerticalOptions="Center" />
                                <Label x:Name="PinnedCountLabel"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Accent}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Grid.Column="1"
                                Text="↑"
                                FontSize="13"
                                WidthRequest="24" Padding="0" MinimumWidthRequest="0" MinimumHeightRequest="0"
                                HeightRequest="24"
                                BackgroundColor="{DynamicResource Accent}"
                                TextColor="White"
                                CornerRadius="6"
                                Clicked="OnPinnedUpClicked"
                                ToolTipProperties.Text="{DynamicResource s_ui_132}" />
                        <Button Grid.Column="2"
                                Text="↓"
                                FontSize="13"
                                WidthRequest="24" Padding="0" MinimumWidthRequest="0" MinimumHeightRequest="0"
                                HeightRequest="24"
                                BackgroundColor="{DynamicResource Accent}"
                                TextColor="White"
                                CornerRadius="6"
                                Clicked="OnPinnedDownClicked"
                                ToolTipProperties.Text="{DynamicResource s_ui_149}" />
                    </Grid>
                    <CollectionView Grid.Row="2"
                                    x:Name="PinnedItemsView"
                                    SelectionMode="None"
                                    BackgroundColor="Transparent">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="views:MessageVm">
                                <Border Margin="12,4"
                                        Padding="10"
                                        BackgroundColor="{DynamicResource SurfaceAlt}"
                                        StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPinnedItemTapped" />
                                    </Border.GestureRecognizers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding DisplayText}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextPrimary}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="3" />
                                        <Label Text="{Binding PinnedAuthorText}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource Accent}"
                                               Margin="0,2,0,0" />
                                        <Label Text="{Binding TimeText}"
                                               FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Grid.Row="3"
                           x:Name="PinnedEmptyLabel"
                           Text="{DynamicResource s_ui_083}"
                           FontSize="12"
                           TextColor="{DynamicResource TextMuted}"
                           Margin="16"
                           IsVisible="False" />
                </Grid>

                <!-- ПЕРЕКЛЮЧАТЕЛЬ ВКЛАДОК -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="6"
                      Padding="10"
                      BackgroundColor="{DynamicResource SurfaceAlt}">
                    <Button Grid.Column="0"
                            x:Name="ProfileTabButton"
                            Text="💬"
                            Style="{DynamicResource IconButton}"
                            Clicked="OnProfileTabClicked"
                            ToolTipProperties.Text="{DynamicResource s_ui_138}" />
                    <Button Grid.Column="1"
                            x:Name="MediaTabButton"
                            Text="📎"
                            Style="{DynamicResource IconButton}"
                            Clicked="OnMediaTabClicked"
                            ToolTipProperties.Text="{DynamicResource s_ui_063}" />
                    <Button Grid.Column="2"
                            x:Name="PinnedTabButton"
                            Text="📌"
                            Style="{DynamicResource IconButton}"
                            Clicked="OnPinnedTabClicked"
                            ToolTipProperties.Text="{DynamicResource s_ui_042}" />
                    <Button Grid.Column="3"
                            Text="📄"
                            Style="{DynamicResource IconButton}"
                            Clicked="OnExportChatClicked"
                            ToolTipProperties.Text="{DynamicResource s_ui_174}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Контекстное меню по правому клику -->
        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              x:Name="ContextMenuOverlay"
              IsVisible="False">
            <BoxView Color="#000000"
                     Opacity="0.45">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnContextMenuDismissed" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="ContextMenuBorder"
                    WidthRequest="230"
                    Padding="6"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout x:Name="ContextMenuItems"
                                     Spacing="2" />
            </Border>
        </Grid>
    
            <!-- Меню скрепки, как в Telegram (Popup поверх всего) -->
            

        </Grid>
</ContentView>






